---
// Latin-only subsets: the plain @fontsource/inter/<weight>.css entrypoints also emit
// cyrillic / greek / latin-ext @font-face blocks, none of which this site can use.
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-800.css';
import '@fontsource/inter/latin-900.css';
// Shared tokens, layout primitives, buttons, a11y and motion live here (not per page).
import '../styles/global.css';

interface Props {
	/** Page name only — the studio name is appended automatically. Don't include it. */
	title?: string;
	/** Per-page meta description. Falls back to the studio boilerplate. */
	description?: string;
}

const {
	title,
	description = 'Six Deep Studios LLC is an independent game studio building physics-driven, fully destructible games. Big Time, our first project, is in prototype.',
} = Astro.props;

const siteName = 'Six Deep Studios';
const pageTitle = title ? `${title} | ${siteName}` : `${siteName} LLC — Independent game studio`;

const origin = Astro.site ?? new URL('https://sixdeepstudios.com');
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL('/og-image.jpg', origin).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#08131c" />
		<link rel="canonical" href={canonical} />

		<!-- Social preview. og-image.jpg is a 1200x630 crop of the key art. -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!--
			Flags that scripting works. The `.reveal` styles hide content, so global.css scopes
			them to `.js` — if this never runs, sections stay visible instead of blank.
		-->
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body>
		<slot />

		<script>
			// Reveal-on-scroll, shared by every page.
			//
			// Sections are visible by default and are only hidden AFTER the observer confirms
			// they are off-screen. That ordering is deliberate: if the observer never reports
			// (throttled tab, unsupported browser, JS blocked) nothing is ever hidden, so the
			// failure mode is "no animation" rather than "blank page".
			const targets = document.querySelectorAll<HTMLElement>('.reveal');
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (!reduceMotion && 'IntersectionObserver' in window) {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.remove('is-hidden');
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							} else {
								entry.target.classList.add('is-hidden');
							}
						}
					},
					{ rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
				);

				targets.forEach((el) => observer.observe(el));
			}
		</script>
	</body>
</html>
