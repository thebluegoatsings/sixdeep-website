---
import '@fontsource/inter/400.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@fontsource/inter/900.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Six Deep Studios LLC is a creative studio building ambitious interactive experiences and future-facing game ideas."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{Astro.props.title ? `${Astro.props.title} | Six Deep Studios` : 'Six Deep Studios LLC'}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #08131c;
		--bg-alt: #0f1e2a;
		--panel: rgba(15, 30, 42, 0.78);
		--panel-strong: rgba(10, 19, 28, 0.96);
		--line: rgba(95, 195, 255, 0.35);
		--text: #edf6ff;
		--muted: #b7c4d1;
		--accent: #fdb913;
		--accent-soft: #ffd54f;
		--secondary: #5fc3ff;
		--success: #96f2b4;
	}

	body {
		margin: 0;
		font-family: Inter, 'Segoe UI', sans-serif;
		background:
			radial-gradient(circle at top, rgba(95, 195, 255, 0.25), transparent 25%),
			radial-gradient(circle at bottom right, rgba(253, 185, 19, 0.15), transparent 30%),
			var(--bg);
		color: var(--text);
		line-height: 1.6;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	img {
		display: block;
		max-width: 100%;
	}
</style>
