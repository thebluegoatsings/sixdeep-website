---
// Interactive 3D wrecking-ball mini-game — a Box3D physics prototype.
// Physics: box3d.js (Box3D WASM). Rendering: three.js.
---

<div class="crane-game3d" id="crane-game3d">
	<div class="game-head">
		<p class="game-copy">
			Rotate the crane with A and D, raise or lower the ball with W and S, and topple every
			box to wreck the wall. This is a tech demo of Box3D — not the game. Big Time will use
			this same engine for its real-time, fully destructible worlds.
		</p>
		<div class="game-ui">
			<div class="score" role="status" aria-live="polite">
				<span class="score-value"><span id="crane3d-count">0</span>/<span id="crane3d-total">0</span></span>
				<span class="score-label">boxes down</span>
			</div>
			<button class="reset-button" id="crane3d-reset" type="button">Reset</button>
		</div>
	</div>

	<div class="game-stage">
		<canvas id="crane3d-canvas" aria-label="Interactive 3D wrecking ball game"></canvas>
		<p class="stage-hint" id="crane3d-hint">A/D rotate the crane &middot; W/S raise &amp; lower</p>
		<p class="stage-error" id="crane3d-error" hidden></p>
	</div>
</div>

<script>
	import * as THREE from 'three';
	import Box3D from 'box3d.js/inline';
	import type { Box3DModule, b3BodyId, b3Capsule, b3JointId, b3Quat, b3Vec3 } from 'box3d.js/inline';

	const canvas = document.getElementById('crane3d-canvas') as HTMLCanvasElement;
	const countEl = document.getElementById('crane3d-count') as HTMLElement;
	const totalEl = document.getElementById('crane3d-total') as HTMLElement;
	const resetBtn = document.getElementById('crane3d-reset') as HTMLButtonElement;
	const hintEl = document.getElementById('crane3d-hint') as HTMLElement;
	const errorEl = document.getElementById('crane3d-error') as HTMLElement;

	// ---- Scene constants (metres, +Y up) ----
	const TOWER_X = -4;
	const TOWER_Z = 0;
	const JIB_Y = 9; // tower / jib height
	const JIB_LENGTH = 4; // jib tip distance from the tower centre
	const BALL_RADIUS = 1.1;
	const LINK_EXTENT = 0.13; // half-length of each chain link
	const LINK_RADIUS = 0.05;
	const CRANE_START_ANGLE = -Math.PI / 2; // jib points -Z at rest, so the ball hangs opposite the wall
	const WALL_CX = 2; // centre of the box wall along X
	const WALL_Z = 3; // the wall is a vertical plane at this Z, close to the swing
	const BOX_HALF = 0.24; // half-extent of each wall box
	const BOX_SPACING = 0.5; // centre-to-centre spacing of the boxes
	const WALL_COLS = 14; // boxes across the wall
	const WALL_ROWS = 14; // boxes up the wall
	const ROTATE_SPEED = 1.4; // rad/s (jib swing)

	// ---- Chain winch (chain draw / pull) ----
	// A spool hangs at the jib tip and the chain's own top links wind around it.
	// As the spool is cranked, each link that reaches the contact point on the
	// spool's underside is taken onto the spool, growing the wound coil; the free
	// chain below that point hangs and swings. Cranking reels the free chain
	// on/off the spool - the chain itself winds around the winch to lift and
	// lower the ball.
	const LINK_PITCH = LINK_EXTENT * 2; // link spacing along the chain (m)
	const SPOOL_R = 0.55; // spool barrel radius (m)
	const SPOOL_HALF_W = 0.22; // half spool depth along Z
	const SPOOL_Y = 7.4; // spool axle height at the jib tip
	// Link density matters far more than it looks like it should, and it is the real fix for the
	// chain looking springy. The ball is ~474 kg; at the old value of 16 each link massed ~0.04 kg,
	// a ~12,000:1 mass ratio the solver cannot resolve. The cost showed up as stretch: ~0.60 m of
	// slack across the free chain at full retract (~120 mm per joint, past the ~100 mm at which
	// adjacent links stop overlapping and a visible gap opens) plus a bouncing ball.
	// Heavier links fix the conditioning rather than just stiffening the joints. At 100 (~0.26 kg per
	// link, ~4.6 kg of chain against a 474 kg ball) the stretch is ~95 mm total, ~19 mm per joint -
	// no visible gap - and the ball hangs within 0.1 m of its geometric height.
	const LINK_DENSITY = 100;
	const LINK_TORQUE = 6; // per-link motor keeps the free chain tidy
	const WRAP_R = SPOOL_R + LINK_RADIUS; // spool surface radius (link centres)
	const DELTA = LINK_PITCH / WRAP_R; // spool radians per link wound on
	const MIN_COIL = 0; // wound links (0 = chain fully paid out)
	const MAX_COIL = 13;
	const START_COIL = 2; // pre-wound so the wrap reads at rest
	const TOTAL_LINKS = 18; // links in the chain (wound + free share these links)
	const WIND_RATE = 4; // links wound/unwound per second (W/S)

	let coil = MIN_COIL; // wound links. The pre-wind loop below winds START_COIL on, so
	// starting this at START_COIL as well used to leave 2xSTART_COIL links wound at load
	// while Reset put it back to START_COIL - the two states disagreed.
	let windFloat = START_COIL; // smoothed wound-count target driven by W/S
	// Eased copy of `coil`, used only to place the wound links and to spin the drum.
	// `coil` is a whole number of links so the ball height stays discrete, but the visual
	// wrap should turn continuously instead of jumping a whole link a few times a second.
	let coilSmooth = START_COIL;
	let craneAngle = CRANE_START_ANGLE; // ball starts on the opposite side of the wall

	// The spool centre rides the moving jib tip (A/D); the spool itself only spins.
	function spoolPoint(): { x: number; y: number; z: number } {
		return {
			x: TOWER_X + JIB_LENGTH * Math.cos(craneAngle),
			y: SPOOL_Y,
			z: TOWER_Z + JIB_LENGTH * Math.sin(craneAngle),
		};
	}
	// Ball centre height for a given wound count: freeLinks = TOTAL_LINKS - coil,
	// each LINK_PITCH long, hanging from the spool's underside (the fairlead).
	function ballYFromCoil(c: number): number {
		return SPOOL_Y - WRAP_R - (TOTAL_LINKS - c) * LINK_PITCH - BALL_RADIUS;
	}

	function rotZ(a: number): b3Quat {
		return [0, 0, Math.sin(a / 2), Math.cos(a / 2)];
	}

	function rotY(a: number): b3Quat {
		return [0, Math.sin(a / 2), 0, Math.cos(a / 2)];
	}

	// Hamilton product: `b` is applied first, then `a`. Used to build "spin the barrel
	// about its own axle, then yaw the whole winch with the jib" as one rotation.
	function quatMul(a: b3Quat, b: b3Quat): b3Quat {
		const [ax, ay, az, aw] = a;
		const [bx, by, bz, bw] = b;
		return [
			aw * bx + ax * bw + ay * bz - az * by,
			aw * by - ax * bz + ay * bw + az * bx,
			aw * bz + ax * by - ay * bx + az * bw,
			aw * bw - ax * bx - ay * by - az * bz,
		];
	}

	// Bake the logo (public/logo.svg) onto a steel background matching the wall
	// aspect, so each box's front face can show its slice of the logo.
	async function loadLogoTexture(cols: number, rows: number): Promise<THREE.CanvasTexture> {
		const img = new Image();
		img.src = '/logo.svg';
		await img.decode();

		const texW = 1024;
		const texH = Math.max(1, Math.round((texW * rows) / cols));
		const canvas = document.createElement('canvas');
		canvas.width = texW;
		canvas.height = texH;
		const ctx = canvas.getContext('2d');
		if (!ctx) throw new Error('no 2d context');

		// Steel background so the texture blends with the plain box sides.
		ctx.fillStyle = '#d7e6ef';
		ctx.fillRect(0, 0, texW, texH);

		// Centre the square badge, letterboxed to keep its aspect.
		const size = Math.min(texW, texH);
		ctx.drawImage(img, (texW - size) / 2, (texH - size) / 2, size, size);

		const texture = new THREE.CanvasTexture(canvas);
		texture.colorSpace = THREE.SRGBColorSpace;
		texture.minFilter = THREE.LinearFilter;
		texture.magFilter = THREE.LinearFilter;
		texture.wrapS = THREE.ClampToEdgeWrapping;
		texture.wrapT = THREE.ClampToEdgeWrapping;
		return texture;
	}

	async function main() {
		let b3: Box3DModule;
		try {
			b3 = await Box3D();
		} catch (err) {
			errorEl.hidden = false;
			errorEl.textContent = 'Failed to load the Box3D physics engine.';
			return;
		}

		// ---- Renderer / scene / camera ----
		const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
		renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
		renderer.shadowMap.enabled = true;
		renderer.shadowMap.type = THREE.PCFShadowMap;

		const scene = new THREE.Scene();
		scene.background = new THREE.Color(0x0a1722);
		scene.fog = new THREE.Fog(0x0a1722, 24, 70);

		const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 200);
		camera.position.set(12, 7, 14);
		camera.lookAt(0.5, 3, 0);

		scene.add(new THREE.HemisphereLight(0xbdd8ee, 0x0e1f2c, 0.9));
		const sun = new THREE.DirectionalLight(0xffe08a, 1.8);
		sun.position.set(12, 18, 10);
		sun.castShadow = true;
		sun.shadow.mapSize.set(2048, 2048);
		sun.shadow.camera.left = -20;
		sun.shadow.camera.right = 20;
		sun.shadow.camera.top = 20;
		sun.shadow.camera.bottom = -20;
		sun.shadow.camera.near = 0.5;
		sun.shadow.camera.far = 60;
		scene.add(sun);

		const groundMesh = new THREE.Mesh(
			new THREE.PlaneGeometry(60, 40),
			new THREE.MeshStandardMaterial({ color: 0x0e1f2c, roughness: 0.95 }),
		);
		groundMesh.rotation.x = -Math.PI / 2;
		groundMesh.receiveShadow = true;
		scene.add(groundMesh);

		// ---- Crane (visual) ----
		const steelMat = new THREE.MeshStandardMaterial({ color: 0xd7e6ef, roughness: 0.4, metalness: 0.6 });
		const accentMat = new THREE.MeshStandardMaterial({ color: 0xe8b21a, roughness: 0.5, metalness: 0.3 });

		const towerMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.35, 0.6, JIB_Y, 16), steelMat);
		towerMesh.position.set(TOWER_X, JIB_Y / 2, TOWER_Z);
		towerMesh.castShadow = true;
		towerMesh.receiveShadow = true;
		scene.add(towerMesh);

		const jibGroup = new THREE.Group();
		jibGroup.position.set(TOWER_X, JIB_Y, TOWER_Z);
		scene.add(jibGroup);

		const jibBeam = new THREE.Mesh(new THREE.BoxGeometry(JIB_LENGTH, 0.35, 0.35), steelMat);
		jibBeam.position.set(JIB_LENGTH / 2, 0, 0);
		jibBeam.castShadow = true;
		jibGroup.add(jibBeam);

		const counterJib = new THREE.Mesh(new THREE.BoxGeometry(1.6, 0.35, 0.35), steelMat);
		counterJib.position.set(-0.8, 0, 0);
		counterJib.castShadow = true;
		jibGroup.add(counterJib);

		const counterweight = new THREE.Mesh(new THREE.BoxGeometry(0.6, 0.8, 0.8), accentMat);
		counterweight.position.set(-1.6, -0.35, 0);
		counterweight.castShadow = true;
		jibGroup.add(counterweight);

		const hub = new THREE.Mesh(new THREE.CylinderGeometry(0.5, 0.5, 0.6, 16), accentMat);
		hub.position.set(0, 0.3, 0);
		hub.castShadow = true;
		jibGroup.add(hub);

		// ---- Spool visual (synced from the physical spool each frame) ----
		const spoolVis = new THREE.Group();
		const spoolBarrel = new THREE.Mesh(
			new THREE.CylinderGeometry(SPOOL_R, SPOOL_R, SPOOL_HALF_W * 2, 28),
			steelMat,
		);
		spoolBarrel.rotation.x = Math.PI / 2; // axis along Z so it spins about Z
		spoolBarrel.castShadow = true;
		spoolVis.add(spoolBarrel);

		for (const side of [-1, 1]) {
			const flange = new THREE.Mesh(new THREE.CylinderGeometry(SPOOL_R + 0.05, SPOOL_R + 0.05, 0.05, 24), accentMat);
			flange.rotation.x = Math.PI / 2;
			flange.position.z = side * (SPOOL_HALF_W + 0.03);
			spoolVis.add(flange);
		}

		// teeth so the winding is readable
		const spoolToothGeo = new THREE.BoxGeometry(0.08, 0.16, SPOOL_HALF_W * 2 - 0.02);
		const spoolToothCount = 16;
		for (let i = 0; i < spoolToothCount; i += 1) {
			const tooth = new THREE.Mesh(spoolToothGeo, accentMat);
			const ang = (i / spoolToothCount) * Math.PI * 2;
			tooth.position.set(Math.cos(ang) * SPOOL_R, Math.sin(ang) * SPOOL_R, 0);
			tooth.rotation.z = ang;
			spoolVis.add(tooth);
		}
		scene.add(spoolVis);

		// ---- Winch mount: a bracket frame on the end of the jib carries the drum ----
		// The drum used to dangle off a single thin post, which read as disconnected from the
		// arm. Now a bridge plate hangs under the jib tip, two slim legs drop from it to a pair
		// of bearing blocks, and the drum turns on the axle between them. Kept deliberately
		// lean so it still leaves the drum's face (and the winding) readable.
		const drumDrop = JIB_Y - SPOOL_Y; // jib tip down to the drum axle
		const legZ = SPOOL_HALF_W + 0.13; // clear of the drum's flanges
		const blockZ = SPOOL_HALF_W + 0.15;

		// Bridge under the beam: this is what ties the whole bracket back into the jib.
		const bridge = new THREE.Mesh(new THREE.BoxGeometry(0.26, 0.1, legZ * 2 + 0.12), steelMat);
		bridge.position.set(JIB_LENGTH, -0.2, 0);
		bridge.castShadow = true;
		jibGroup.add(bridge);

		// Legs: from the bridge down to the bearing blocks.
		const legGeo = new THREE.BoxGeometry(0.26, drumDrop - 0.08, 0.12);
		for (const side of [-1, 1]) {
			const leg = new THREE.Mesh(legGeo, steelMat);
			leg.position.set(JIB_LENGTH, -(drumDrop - 0.08) / 2 - 0.14, side * legZ);
			leg.castShadow = true;
			jibGroup.add(leg);
		}

		// Bearing blocks the axle sits in.
		const blockGeo = new THREE.BoxGeometry(0.34, 0.34, 0.12);
		for (const side of [-1, 1]) {
			const block = new THREE.Mesh(blockGeo, steelMat);
			block.position.set(JIB_LENGTH, -drumDrop, side * blockZ);
			block.castShadow = true;
			jibGroup.add(block);
		}

		// Local Z is the drum's spin axis (the winch shares the jib's yaw).
		const axle = new THREE.Mesh(new THREE.CylinderGeometry(0.085, 0.085, blockZ * 2 + 0.16, 14), steelMat);
		axle.rotation.x = Math.PI / 2;
		axle.position.set(JIB_LENGTH, -drumDrop, 0);
		axle.castShadow = true;
		jibGroup.add(axle);

		// Accent collars on the shaft ends.
		const collarGeo = new THREE.CylinderGeometry(0.11, 0.11, 0.07, 16);
		for (const side of [-1, 1]) {
			const collar = new THREE.Mesh(collarGeo, accentMat);
			collar.rotation.x = Math.PI / 2;
			collar.position.set(JIB_LENGTH, -drumDrop, side * (blockZ + 0.06));
			collar.castShadow = true;
			jibGroup.add(collar);
		}

		// ---- Physics world ----
		const worldDef = b3.b3DefaultWorldDef();
		worldDef.gravity = [0, -9, 0]; // a touch lighter than real gravity
		const world = b3.b3CreateWorld(worldDef);

		// ground body (static)
		const groundDef = b3.b3DefaultBodyDef();
		groundDef.position = [0, -0.25, 0];
		const groundBody = b3.b3CreateBody(world, groundDef);
		b3.b3CreateBoxShape(groundBody, b3.b3DefaultShapeDef(), 15, 0.25, 10);

		// crane tower body (static)
		const towerDef = b3.b3DefaultBodyDef();
		towerDef.position = [TOWER_X, JIB_Y / 2, TOWER_Z];
		const towerBody = b3.b3CreateBody(world, towerDef);
		b3.b3CreateBoxShape(towerBody, b3.b3DefaultShapeDef(), 0.5, JIB_Y / 2, 0.5);

		// ---- Chain winch: spool + wound coil + free chain + ball ----
		interface ChainLinkRec {
			id: b3BodyId;
			mesh: THREE.Mesh;
			next: b3JointId | null; // spherical to the link below / to the ball
		}
		const s0 = spoolPoint();

		// Kinematic spool at the jib tip: WE set its pose every frame, so the wound
		// coil is always driven and can never stall under the chain's load.
		const spoolDef = b3.b3DefaultBodyDef();
		spoolDef.type = b3.b3BodyType.b3_kinematicBody;
		spoolDef.position = [s0.x, s0.y, s0.z];
		const spoolBody = b3.b3CreateBody(world, spoolDef);
		const spoolShapeDef = b3.b3DefaultShapeDef();
		const spoolHull = b3.b3CreateCylinder(SPOOL_HALF_W * 2, SPOOL_R, 0, 24);
		const spoolShapeId = b3.b3CreateTransformedHullShape(
			spoolBody,
			spoolShapeDef,
			spoolHull,
			{ position: [0, 0, 0], quaternion: rotZ(Math.PI / 2) }, // hull Y -> Z
			[1, 1, 1],
		);
		b3.b3Shape_SetFilter(spoolShapeId, { categoryBits: 0n, maskBits: 0n, groupIndex: 0 }, false);
		b3.b3DestroyHull(spoolHull);

		// The drum is mounted on the jib, so it always faces the way the arm points: its
		// spin axis stays horizontal and perpendicular to the jib, and the coil wraps in the
		// vertical plane that contains the jib.
		function spoolYaw(): b3Quat {
			return rotY(-craneAngle);
		}

		// The spool body is kinematic and we set its pose ourselves every frame.
		//
		// It is deliberately YAW ONLY: the barrel's winding spin is applied to the visual
		// mesh instead (see the render loop). The free chain's top link is pinned to a frame
		// on this body, so if the body itself spun with the winding it would drag the chain's
		// exit point up and around the drum. Leaving the body unspun keeps the fairlead
		// bolted to the bottom of the drum - the chain always leaves from the same spot -
		// while the drum still visibly turns.
		function setSpoolPose() {
			const p = spoolPoint();
			b3.b3Body_SetTransform(spoolBody, [p.x, p.y, p.z], spoolYaw());
			b3.b3Body_SetLinearVelocity(spoolBody, [0, 0, 0]);
			b3.b3Body_SetAngularVelocity(spoolBody, [0, 0, 0]);
		}
		setSpoolPose();

		// ball body (dynamic sphere - it does the wrecking)
		const ballDef = b3.b3DefaultBodyDef();
		ballDef.type = b3.b3BodyType.b3_dynamicBody;
		ballDef.position = [s0.x, ballYFromCoil(coil), s0.z];
		ballDef.linearDamping = 0.2;
		ballDef.angularDamping = 0.4;
		// The chain and ball must never sleep. A hanging ball is motionless, so it qualifies for
		// sleep almost immediately - and a sleeping body ignores the crane's movement entirely,
		// which silently kills the swing. (The old, springier chain kept jittering just enough to
		// stay awake, which masked this.) The 196 wall boxes still sleep normally.
		ballDef.enableSleep = false;
		const ballBody = b3.b3CreateBody(world, ballDef);
		const ballShapeDef = b3.b3DefaultShapeDef();
		ballShapeDef.density = 85;
		ballShapeDef.baseMaterial.friction = 0.4;
		ballShapeDef.baseMaterial.restitution = 0.05;
		b3.b3CreateSphereShape(ballBody, ballShapeDef, { center: [0, 0, 0], radius: BALL_RADIUS });

		// ball mesh
		const ballMesh = new THREE.Mesh(
			new THREE.SphereGeometry(BALL_RADIUS, 48, 32),
			new THREE.MeshStandardMaterial({ color: 0xfdb913, roughness: 0.35, metalness: 0.4 }),
		);
		ballMesh.castShadow = true;
		ballMesh.receiveShadow = true;
		scene.add(ballMesh);

		// ---- Chain of capsule links. recs[0..coil-1] are wound onto the spool;
		// recs[coil..] are the free chain that hangs below and swings. ----
		const recs: ChainLinkRec[] = [];
		const linkGeo = new THREE.CapsuleGeometry(LINK_RADIUS, LINK_EXTENT * 2, 5, 8);
		const linkMat = new THREE.MeshStandardMaterial({ color: 0xd7e6ef, roughness: 0.4, metalness: 0.6 });

		const capsule: b3Capsule = {
			center1: [0, -LINK_EXTENT, 0],
			center2: [0, LINK_EXTENT, 0],
			radius: LINK_RADIUS,
		};
		const linkShapeDef = b3.b3DefaultShapeDef();
		linkShapeDef.density = LINK_DENSITY;
		linkShapeDef.baseMaterial.restitution = 0;

		const linkBodyDef = b3.b3DefaultBodyDef();
		linkBodyDef.type = b3.b3BodyType.b3_dynamicBody;
		linkBodyDef.linearDamping = 0.04;
		linkBodyDef.angularDamping = 0.04;
		linkBodyDef.enableSleep = false; // see the note on ballDef.enableSleep

		const linkJointDef = b3.b3DefaultSphericalJointDef();
		linkJointDef.enableMotor = true;
		linkJointDef.maxMotorTorque = LINK_TORQUE;
		// Deliberately NOT softened: constraintHertz is this constraint's stiffness, and 0 would
		// zero the position-correction bias so the ball would silently sink. Measured across
		// 0 / 200 / 800 / 1600 Hz: 800 is the stiffest setting that stays clean (1600 jitters for
		// no extra rigidity). With the heavier links above, the chain is taut at this value.
		linkJointDef.base.constraintHertz = 200;

		const fairY = SPOOL_Y - WRAP_R; // underside of the spool (chain exit)

		// hang all TOTAL_LINKS links straight down below the spool (index 0 = top)
		for (let i = 0; i < TOTAL_LINKS; i += 1) {
			linkBodyDef.position = [s0.x, fairY - (1 + 2 * i) * LINK_EXTENT, s0.z];
			const id = b3.b3CreateBody(world, linkBodyDef);
			const shapeId = b3.b3CreateCapsuleShape(id, linkShapeDef, capsule);
			b3.b3Shape_SetFilter(shapeId, { categoryBits: 0n, maskBits: 0n, groupIndex: 0 }, false); // never collide

			const mesh = new THREE.Mesh(linkGeo, linkMat);
			mesh.castShadow = true;
			scene.add(mesh);
			recs.push({ id, mesh, next: null });
		}

		// chain joints: recs[i] <-> recs[i+1], last <-> ball
		for (let i = 0; i < TOTAL_LINKS - 1; i += 1) {
			linkJointDef.base.bodyIdA = recs[i].id;
			linkJointDef.base.bodyIdB = recs[i + 1].id;
			linkJointDef.base.localFrameA = { position: [0, -LINK_EXTENT, 0], quaternion: [0, 0, 0, 1] };
			linkJointDef.base.localFrameB = { position: [0, LINK_EXTENT, 0], quaternion: [0, 0, 0, 1] };
			recs[i].next = b3.b3CreateSphericalJoint(world, linkJointDef);
		}
		linkJointDef.base.bodyIdA = recs[TOTAL_LINKS - 1].id;
		linkJointDef.base.bodyIdB = ballBody;
		linkJointDef.base.localFrameA = { position: [0, -LINK_EXTENT, 0], quaternion: [0, 0, 0, 1] };
		linkJointDef.base.localFrameB = { position: [0, BALL_RADIUS, 0], quaternion: [0, 0, 0, 1] };
		recs[TOTAL_LINKS - 1].next = b3.b3CreateSphericalJoint(world, linkJointDef);

		// boundary joint: spool underside <-> free top link's top end (the fairlead)
		let boundaryJ: b3JointId | null = null;
		function connectBoundary() {
			const top = recs[coil];
			linkJointDef.base.bodyIdA = spoolBody;
			linkJointDef.base.bodyIdB = top.id;
			linkJointDef.base.localFrameA = { position: [0, -WRAP_R, 0], quaternion: [0, 0, 0, 1] };
			linkJointDef.base.localFrameB = { position: [0, LINK_EXTENT, 0], quaternion: [0, 0, 0, 1] };
			boundaryJ = b3.b3CreateSphericalJoint(world, linkJointDef);
		}

		// --- winding: recs[0..coil-1] are wound onto the spool ---
		// Wound links are driven onto the spool every frame, so they visibly wrap
		// around it as the coil grows, while the free chain recs[coil..] hangs below
		// and swings. No weld joints - the driven links cannot fight the solver.
		function driveWoundLinks() {
			const c = spoolPoint();
			const dirX = Math.cos(craneAngle); // the direction the jib points
			const dirZ = Math.sin(craneAngle);
			const yaw = spoolYaw();
			for (let i = 0; i < coil; i += 1) {
				// Angle around the barrel measured from the fairlead (straight down), taken in
				// the vertical plane that contains the jib - so the coil tracks the arm.
				const a = (coilSmooth - 1 - i) * DELTA;
				const offset = WRAP_R * Math.sin(a); // displacement along the jib
				b3.b3Body_SetTransform(
					recs[i].id,
					[c.x + offset * dirX, c.y - WRAP_R * Math.cos(a), c.z + offset * dirZ],
					quatMul(yaw, rotZ(a - Math.PI / 2)),
				);
				b3.b3Body_SetLinearVelocity(recs[i].id, [0, 0, 0]);
				b3.b3Body_SetAngularVelocity(recs[i].id, [0, 0, 0]);
			}
		}
		function windIn() {
			if (coil >= MAX_COIL) return;
			const top = recs[coil]; // free top, hanging from the fairlead
			if (boundaryJ) b3.b3DestroyJoint(boundaryJ, true);
			boundaryJ = null;
			if (top.next) b3.b3DestroyJoint(top.next, true); // detach it from the free chain
			top.next = null;
			coil += 1; // it is now a wound link - driveWoundLinks() places it on the spool
			connectBoundary(); // free chain now hangs from the next link
		}
		function windOut() {
			if (coil <= MIN_COIL) return;
			const outer = recs[coil - 1]; // outermost wound link (currently at the fairlead)
			if (boundaryJ) b3.b3DestroyJoint(boundaryJ, true);
			boundaryJ = null;
			// put it back at the top of the free chain, hanging below the fairlead
			const p = spoolPoint();
			b3.b3Body_SetTransform(outer.id, [p.x, p.y - WRAP_R - LINK_EXTENT, p.z], [0, 0, 0, 1]);
			b3.b3Body_SetLinearVelocity(outer.id, [0, 0, 0]);
			b3.b3Body_SetAngularVelocity(outer.id, [0, 0, 0]);
			linkJointDef.base.bodyIdA = outer.id;
			linkJointDef.base.bodyIdB = recs[coil].id;
			linkJointDef.base.localFrameA = { position: [0, -LINK_EXTENT, 0], quaternion: [0, 0, 0, 1] };
			linkJointDef.base.localFrameB = { position: [0, LINK_EXTENT, 0], quaternion: [0, 0, 0, 1] };
			outer.next = b3.b3CreateSphericalJoint(world, linkJointDef);
			coil -= 1;
			connectBoundary();
		}
		// Reposition the free links (and the ball) to hang from the fairlead.
		function hangFreeChain() {
			const c = spoolPoint();
			const y0 = c.y - WRAP_R;
			for (let i = coil; i < TOTAL_LINKS; i += 1) {
				b3.b3Body_SetTransform(recs[i].id, [c.x, y0 - (1 + 2 * (i - coil)) * LINK_EXTENT, c.z], [0, 0, 0, 1]);
				b3.b3Body_SetLinearVelocity(recs[i].id, [0, 0, 0]);
				b3.b3Body_SetAngularVelocity(recs[i].id, [0, 0, 0]);
			}
			b3.b3Body_SetTransform(ballBody, [c.x, ballYFromCoil(coil), c.z], [0, 0, 0, 1]);
			b3.b3Body_SetLinearVelocity(ballBody, [0, 0, 0]);
			b3.b3Body_SetAngularVelocity(ballBody, [0, 0, 0]);
		}

		// --- pre-wind START_COIL links so a coil is visible at rest ---
		connectBoundary();
		for (let k = 0; k < START_COIL; k += 1) windIn();
		coilSmooth = coil;
		driveWoundLinks();
		hangFreeChain();
		setSpoolPose();

		// ---- Box wall with the logo painted across the box faces ----
		const boxTemplate = new THREE.BoxGeometry(BOX_HALF * 2, BOX_HALF * 2, BOX_HALF * 2);
		const sideMat = new THREE.MeshStandardMaterial({ color: 0xd7e6ef, roughness: 0.55, metalness: 0.45 });

		let logoTexture: THREE.CanvasTexture | null = null;
		try {
			logoTexture = await loadLogoTexture(WALL_COLS, WALL_ROWS);
		} catch {
			// logo unavailable — the wall stays plain steel
		}
		const frontMat = new THREE.MeshStandardMaterial({
			color: logoTexture ? 0xffffff : 0xd7e6ef,
			map: logoTexture,
			roughness: 0.6,
			metalness: 0.1,
		});
		const faceMaterials = [sideMat, sideMat, sideMat, sideMat, frontMat, sideMat];

		let boxes: { id: b3BodyId; mesh: THREE.Mesh }[] = [];
		const knocked = new Set<number>();

		// Map a box's front (+z) face to its slice of the logo texture, using its
		// actual x position so the logo stays continuous across staggered rows.
		function setBoxFrontUV(geo: THREE.BufferGeometry, x: number, row: number, leftCenter: number, xRange: number) {
			const pos = geo.getAttribute('position') as THREE.BufferAttribute;
			const uv = geo.getAttribute('uv') as THREE.BufferAttribute;
			const uCenter = (x - leftCenter) / xRange;
			const halfU = BOX_SPACING / 2 / xRange;
			const u0 = uCenter - halfU;
			const u1 = uCenter + halfU;
			const v0 = (WALL_ROWS - 1 - row) / WALL_ROWS;
			const v1 = (WALL_ROWS - row) / WALL_ROWS;
			for (let i = 0; i < pos.count; i += 1) {
				if (pos.getZ(i) > 0) {
					uv.setXY(i, pos.getX(i) > 0 ? u1 : u0, pos.getY(i) > 0 ? v1 : v0);
				}
			}
			uv.needsUpdate = true;
		}

		function createWall() {
			const shapeDef = b3.b3DefaultShapeDef();
			shapeDef.density = 30;
			shapeDef.baseMaterial.friction = 0.8;
			shapeDef.baseMaterial.restitution = 0;

			const list: { id: b3BodyId; mesh: THREE.Mesh }[] = [];
			// A quarter of the spacing, not a half. At a half, the outer box of every offset
			// row has its centre of mass exactly on the edge of the box below it, so it topples
			// on its own at spawn and the score reads 1 before the player touches anything.
			// A quarter still reads as a brick offset but sits well inside the support.
			const rowStagger = BOX_SPACING / 4;
			const leftCenter = WALL_CX - ((WALL_COLS - 1) / 2) * BOX_SPACING;
			const rightCenter = leftCenter + (WALL_COLS - 1) * BOX_SPACING + rowStagger;
			const xRange = rightCenter - leftCenter;

			for (let row = 0; row < WALL_ROWS; row += 1) {
				const y = BOX_HALF + (WALL_ROWS - 1 - row) * BOX_SPACING;
				const stagger = (row % 2) * rowStagger;
				for (let col = 0; col < WALL_COLS; col += 1) {
					const x = WALL_CX + (col - (WALL_COLS - 1) / 2) * BOX_SPACING + stagger;

					const def = b3.b3DefaultBodyDef();
					def.type = b3.b3BodyType.b3_dynamicBody;
					def.position = [x, y, WALL_Z];
					const id = b3.b3CreateBody(world, def);
					b3.b3CreateBoxShape(id, shapeDef, BOX_HALF, BOX_HALF, BOX_HALF);

					const geo = boxTemplate.clone();
					if (logoTexture) setBoxFrontUV(geo, x, row, leftCenter, xRange);

					const mesh = new THREE.Mesh(geo, faceMaterials);
					mesh.castShadow = true;
					mesh.receiveShadow = true;
					scene.add(mesh);
					list.push({ id, mesh });
				}
			}

			return list;
		}

		boxes = createWall();
		totalEl.textContent = String(boxes.length);

		// ---- Scratch buffers (out-param-first, zero-allocation) ----
		const ballPos: b3Vec3 = [0, 0, 0];
		const ballRot: b3Quat = [0, 0, 0, 1];
		const pos: b3Vec3 = [0, 0, 0];
		const rot: b3Quat = [0, 0, 0, 1];

		// ---- Reset ----
		function resetGame() {
			for (const c of boxes) {
				b3.b3DestroyBody(c.id);
				scene.remove(c.mesh);
			}
			boxes = createWall();
			totalEl.textContent = String(boxes.length);

			craneAngle = CRANE_START_ANGLE;
			// return the winch to its starting wound state
			while (coil > START_COIL) windOut();
			while (coil < START_COIL) windIn();
			windFloat = coil;
			coilSmooth = coil;
			setSpoolPose();
			driveWoundLinks();
			hangFreeChain();

			knocked.clear();
			countEl.textContent = '0';
		}

		resetBtn.addEventListener('click', resetGame);

		// ---- Keyboard controls ----
		const keys = new Set<string>();
		window.addEventListener('keydown', (event) => {
			const k = event.key.toLowerCase();
			if (k === 'a' || k === 'd' || k === 'w' || k === 's') {
				keys.add(k);
				event.preventDefault();
			}
		});
		window.addEventListener('keyup', (event) => {
			keys.delete(event.key.toLowerCase());
		});
		window.addEventListener('blur', () => keys.clear());

		// ---- Resize ----
		function resize() {
			const stage = canvas.parentElement as HTMLElement;
			const w = stage.clientWidth;
			const h = stage.clientHeight;
			renderer.setSize(w, h, false);
			camera.aspect = w / h;
			camera.updateProjectionMatrix();
		}
		resize();
		if (typeof ResizeObserver !== 'undefined') {
			new ResizeObserver(resize).observe(canvas.parentElement as Element);
		} else {
			window.addEventListener('resize', resize);
		}

		// ---- Score / win state ----
		function updateScore() {
			for (const c of boxes) {
				if (!knocked.has(c.id.index1)) {
					b3.b3Body_GetRotation(rot, c.id);
					const upY = 1 - 2 * (rot[0] * rot[0] + rot[2] * rot[2]);
					if (upY < 0.82) knocked.add(c.id.index1);
				}
			}
			countEl.textContent = String(knocked.size);

			if (knocked.size === boxes.length) {
				hintEl.textContent = 'Wall wrecked! Nice demolition.';
				hintEl.classList.add('is-win');
			} else {
				hintEl.textContent = 'A/D rotate \u00b7 W/S raise & lower';
				hintEl.classList.remove('is-win');
			}
		}

		// ---- Loop ----
		let lastTime = performance.now();

		// One simulation + render step. Split out from the animation frame so that timing
		// (which the browser decides) stays separate from the work (which is deterministic).
		function step(dt: number) {
			if (keys.has('a')) craneAngle += ROTATE_SPEED * dt;
			if (keys.has('d')) craneAngle -= ROTATE_SPEED * dt;

			// W/S crank the spool: winding in (W) winds chain links onto the spool and
			// lifts the ball; letting out (S) pays the links back down.
			const windDir = (keys.has('w') ? 1 : 0) - (keys.has('s') ? 1 : 0);
			windFloat = Math.max(MIN_COIL, Math.min(MAX_COIL, windFloat + windDir * WIND_RATE * dt));
			const desiredCoil = Math.round(windFloat);
			// drive the coil toward the target, one link per step
			if (desiredCoil > coil) windIn();
			else if (desiredCoil < coil) windOut();
			// Ease the wound count used for placement, so the coil and the drum turn
			// together smoothly instead of snapping a whole link around on each step.
			// Exponential form so the rate does not change with frame time.
			coilSmooth += (coil - coilSmooth) * (1 - Math.exp(-dt * 14));
			setSpoolPose();
			driveWoundLinks();

			// rotate the jib visual
			jibGroup.rotation.y = -craneAngle;

			b3.b3World_Step(world, dt, 28);

			// Sync the spool visual from the physical spool, then add the winding spin on top.
			// The body is yaw-only, so the barrel's turning lives here rather than in physics.
			b3.b3Body_GetPosition(pos, spoolBody);
			b3.b3Body_GetRotation(rot, spoolBody);
			const spun = quatMul([rot[0], rot[1], rot[2], rot[3]], rotZ(coilSmooth * DELTA));
			spoolVis.position.set(pos[0], pos[1], pos[2]);
			spoolVis.quaternion.set(spun[0], spun[1], spun[2], spun[3]);

			// sync every chain link (wound coil and free chain alike)
			for (const link of recs) {
				b3.b3Body_GetPosition(pos, link.id);
				b3.b3Body_GetRotation(rot, link.id);
				link.mesh.position.set(pos[0], pos[1], pos[2]);
				link.mesh.quaternion.set(rot[0], rot[1], rot[2], rot[3]);
			}

			// sync ball
			b3.b3Body_GetPosition(ballPos, ballBody);
			b3.b3Body_GetRotation(ballRot, ballBody);
			ballMesh.position.set(ballPos[0], ballPos[1], ballPos[2]);
			ballMesh.quaternion.set(ballRot[0], ballRot[1], ballRot[2], ballRot[3]);

			// sync boxes
			for (const c of boxes) {
				b3.b3Body_GetPosition(pos, c.id);
				b3.b3Body_GetRotation(rot, c.id);
				c.mesh.position.set(pos[0], pos[1], pos[2]);
				c.mesh.quaternion.set(rot[0], rot[1], rot[2], rot[3]);
			}

			updateScore();
			renderer.render(scene, camera);
		}

		function loop(now: number) {
			requestAnimationFrame(loop);
			const dt = Math.min((now - lastTime) / 1000, 1 / 30);
			lastTime = now;
			step(dt);
		}

		requestAnimationFrame(loop);
	}

	main();
</script>

<style>
	.crane-game3d {
		margin-top: 28px;
	}

	.game-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		flex-wrap: wrap;
		gap: 20px;
		margin-bottom: 20px;
	}

	.game-copy {
		margin: 0;
		max-width: 600px;
		color: var(--muted);
		line-height: 1.6;
	}

	.game-ui {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 12px;
	}

	.score {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		line-height: 1.1;
	}

	.score-value {
		font-size: 2rem;
		font-weight: 900;
		letter-spacing: -0.03em;
		color: var(--accent);
	}

	.score-label {
		color: var(--muted);
		font-size: 0.85rem;
	}

	.reset-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 42px;
		padding: 0 18px;
		border: 1px solid rgba(154, 199, 226, 0.26);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.02);
		color: var(--text);
		font-weight: 700;
		font-size: 0.9rem;
		cursor: pointer;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.reset-button:hover {
		transform: translateY(-1px);
		border-color: var(--line);
		background: rgba(255, 255, 255, 0.06);
	}

	.game-stage {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		border: 1px solid var(--line);
		border-radius: 24px;
		background: #08131c;
		box-shadow: 0 28px 70px rgba(2, 5, 10, 0.5);
	}

	canvas {
		display: block;
		width: 100%;
		height: 100%;
		touch-action: none;
		user-select: none;
		-webkit-user-select: none;
	}

	.stage-hint {
		position: absolute;
		bottom: 14px;
		left: 50%;
		transform: translateX(-50%);
		margin: 0;
		padding: 8px 16px;
		font-size: 0.8rem;
		color: var(--muted);
		white-space: nowrap;
		background: rgba(9, 17, 24, 0.82);
		border: 1px solid var(--line);
		border-radius: 999px;
		pointer-events: none;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.stage-hint.is-active {
		color: var(--text);
		border-color: var(--secondary);
	}

	.stage-hint.is-win {
		color: var(--success);
		border-color: rgba(150, 242, 180, 0.5);
	}

	.stage-error {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		margin: 0;
		color: #ff9b9b;
		text-align: center;
	}

	@media (max-width: 620px) {
		.game-ui {
			align-items: flex-start;
		}

		.stage-hint {
			white-space: normal;
			text-align: center;
			max-width: calc(100% - 32px);
		}
	}
</style>
