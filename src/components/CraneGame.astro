---
// Interactive "Crane Smasher" mini-game — a playable teaser for Big Time.
// Physics is simulated with Matter.js; rendering is a custom Canvas 2D loop
// so the visuals match the site's dark gold/blue theme.
---

<div class="crane-game" id="crane-game">
	<div class="game-head">
		<p class="game-copy">
			Drag the ball side-to-side to swing, and up and down to raise or lower it. Topple every
			can to wreck the wall.
		</p>
		<div class="game-ui">
			<div class="score" role="status" aria-live="polite">
				<span class="score-value"><span id="crane-count">0</span>/<span id="crane-total">10</span></span>
				<span class="score-label">cans down</span>
			</div>
			<button class="reset-button" id="crane-reset" type="button">Reset</button>
		</div>
	</div>

	<div class="game-stage">
		<canvas id="crane-canvas" aria-label="Interactive crane wrecking ball game"></canvas>
		<p class="stage-hint" id="crane-hint">Drag the ball to swing &middot; up and down to raise &amp; lower</p>
	</div>
</div>

<script>
	import Matter from 'matter-js';

	const { Engine, Bodies, Body, Composite, Constraint, Sleeping } = Matter;

	const canvas = document.getElementById('crane-canvas') as HTMLCanvasElement;
	const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;
	const countEl = document.getElementById('crane-count') as HTMLElement;
	const totalEl = document.getElementById('crane-total') as HTMLElement;
	const resetBtn = document.getElementById('crane-reset') as HTMLButtonElement;
	const hintEl = document.getElementById('crane-hint') as HTMLElement;

	// ---- World (physics units; rendered into a 16:9 canvas) ----
	const WORLD_W = 960;
	const WORLD_H = 540;
	const GROUND_Y = 500;

	// ---- Wrecking ball ----
	const ANCHOR = { x: 380, y: 0 };
	const BALL_RADIUS = 36;
	const ROPE_MIN = 140;
	const ROPE_MAX = 460;
	const ROPE_DEFAULT = 300;

	// ---- Cans ----
	const CAN_W = 54;
	const CAN_H = 88;
	const CAN_GAP = 6;
	const CAN_ROWS = [4, 3, 2, 1]; // bottom row first
	const PYRAMID_CX = 540;

	let ropeLength = ROPE_DEFAULT;

	const clamp = (value: number, min: number, max: number): number => Math.min(max, Math.max(min, value));

	// ---- Engine & world ----
	const engine = Engine.create({ enableSleeping: true });
	engine.gravity.y = 0.6; // slower, weightier physics

	const ground = Bodies.rectangle(WORLD_W / 2, GROUND_Y + 60, WORLD_W + 400, 120, {
		isStatic: true,
		label: 'ground',
	});

	const anchor = Bodies.circle(ANCHOR.x, ANCHOR.y, 4, {
		isStatic: true,
		label: 'anchor',
	});

	const ball = Bodies.circle(
		ANCHOR.x,
		ANCHOR.y + ROPE_DEFAULT,
		BALL_RADIUS,
		{
			label: 'ball',
			restitution: 0.08,
			friction: 0.45,
			density: 0.006,
		},
	);

	const rope = Constraint.create({
		bodyA: anchor,
		bodyB: ball,
		length: ROPE_DEFAULT,
		stiffness: 1,
		damping: 0.1,
	});

	let cans = createCans();
	const knockedCans = new Set();

	Composite.add(engine.world, [ground, anchor, ball, rope, ...cans]);
	totalEl.textContent = String(cans.length);

	function createCans(): Matter.Body[] {
		const list: Matter.Body[] = [];
		CAN_ROWS.forEach((n, row) => {
			const rowWidth = n * CAN_W + (n - 1) * CAN_GAP;
			const y = GROUND_Y - row * (CAN_H + 2) - CAN_H / 2;
			for (let i = 0; i < n; i += 1) {
				const x = PYRAMID_CX - rowWidth / 2 + CAN_W / 2 + i * (CAN_W + CAN_GAP);
				list.push(
					Bodies.rectangle(x, y, CAN_W, CAN_H, {
						label: 'can',
						restitution: 0.02,
						friction: 0.55,
						density: 0.0007,
					}),
				);
			}
		});
		return list;
	}

	// ---- Pointer drag (mouse + touch via pointer events) ----
	let drag: { px: number; py: number } | null = null;

	function pointerToWorld(event: PointerEvent) {
		const rect = canvas.getBoundingClientRect();
		return {
			x: ((event.clientX - rect.left) / rect.width) * WORLD_W,
			y: ((event.clientY - rect.top) / rect.height) * WORLD_H,
		};
	}

	function setCursor(event: PointerEvent) {
		if (drag) return;
		const p = pointerToWorld(event);
		const nearBall = Math.hypot(p.x - ball.position.x, p.y - ball.position.y) < BALL_RADIUS + 40;
		canvas.style.cursor = nearBall ? 'grab' : 'default';
	}

	canvas.addEventListener('pointerdown', (event) => {
		const p = pointerToWorld(event);
		const nearBall = Math.hypot(p.x - ball.position.x, p.y - ball.position.y) < BALL_RADIUS + 40;

		if (nearBall) {
			drag = { px: p.x, py: p.y };
			canvas.setPointerCapture(event.pointerId);
			canvas.style.cursor = 'grabbing';
			hintEl.classList.add('is-active');
			event.preventDefault();
		}
	});

	canvas.addEventListener('pointermove', (event) => {
		if (!drag) {
			setCursor(event);
			return;
		}
		const p = pointerToWorld(event);
		const dy = p.y - drag.py;
		ropeLength = clamp(ropeLength + dy * 1.1, ROPE_MIN, ROPE_MAX);
		drag.px = p.x;
		drag.py = p.y;
	});

	function endDrag() {
		drag = null;
		canvas.style.cursor = 'default';
		hintEl.classList.remove('is-active');
	}

	canvas.addEventListener('pointerup', endDrag);
	canvas.addEventListener('pointercancel', endDrag);
	canvas.addEventListener('lostpointercapture', endDrag);

	// ---- Rendering ----
	function resize() {
		const stage = canvas.parentElement as HTMLElement;
		const cssWidth = stage.clientWidth;
		const cssHeight = stage.clientHeight;
		const dpr = window.devicePixelRatio || 1;
		canvas.width = Math.max(1, Math.round(cssWidth * dpr));
		canvas.height = Math.max(1, Math.round(cssHeight * dpr));
		ctx.setTransform(canvas.width / WORLD_W, 0, 0, canvas.height / WORLD_H, 0, 0);
	}

	function roundRectPath(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
		const rr = Math.min(r, w / 2, h / 2);
		ctx.beginPath();
		ctx.moveTo(x + rr, y);
		ctx.arcTo(x + w, y, x + w, y + h, rr);
		ctx.arcTo(x + w, y + h, x, y + h, rr);
		ctx.arcTo(x, y + h, x, y, rr);
		ctx.arcTo(x, y, x + w, y, rr);
		ctx.closePath();
	}

	function drawBackground() {
		// sky
		const sky = ctx.createLinearGradient(0, 0, 0, GROUND_Y);
		sky.addColorStop(0, '#0a1722');
		sky.addColorStop(0.6, '#0e1f2c');
		sky.addColorStop(1, '#132d3d');
		ctx.fillStyle = sky;
		ctx.fillRect(0, 0, WORLD_W, GROUND_Y);

		// warm glow behind the cans
		const glow = ctx.createRadialGradient(720, 180, 20, 720, 180, 260);
		glow.addColorStop(0, 'rgba(253, 185, 19, 0.16)');
		glow.addColorStop(1, 'rgba(253, 185, 19, 0)');
		ctx.fillStyle = glow;
		ctx.fillRect(0, 0, WORLD_W, GROUND_Y);

		// distant skyline
		const buildings: [number, number, number][] = [
			[20, 320, 70], [100, 260, 60], [170, 350, 80], [240, 240, 55],
			[310, 290, 65], [400, 220, 70], [480, 280, 60], [560, 330, 75],
			[650, 250, 60], [730, 300, 65], [810, 340, 70], [880, 260, 60],
		];
		ctx.fillStyle = 'rgba(8, 19, 28, 0.88)';
		for (const [x, h, w] of buildings) {
			ctx.fillRect(x, GROUND_Y - h, w, h);
		}

		// lit windows
		ctx.fillStyle = 'rgba(114, 212, 255, 0.3)';
		for (const [x, h, w] of buildings) {
			for (let wy = GROUND_Y - h + 16; wy < GROUND_Y - 20; wy += 24) {
				for (let wx = x + 9; wx < x + w - 12; wx += 17) {
					ctx.fillRect(wx, wy, 5, 9);
				}
			}
		}
	}

	function drawGround() {
		const grad = ctx.createLinearGradient(0, GROUND_Y, 0, WORLD_H);
		grad.addColorStop(0, '#0E1F2C');
		grad.addColorStop(1, '#08131C');
		ctx.fillStyle = grad;
		ctx.fillRect(0, GROUND_Y, WORLD_W, WORLD_H - GROUND_Y);

		ctx.fillStyle = 'rgba(114, 212, 255, 0.28)';
		ctx.fillRect(0, GROUND_Y, WORLD_W, 3);

		// faint construction striping
		ctx.fillStyle = 'rgba(247, 179, 43, 0.06)';
		for (let x = 0; x < WORLD_W; x += 80) {
			ctx.beginPath();
			ctx.moveTo(x, WORLD_H);
			ctx.lineTo(x + 40, GROUND_Y);
			ctx.lineTo(x + 80, GROUND_Y);
			ctx.lineTo(x + 40, WORLD_H);
			ctx.closePath();
			ctx.fill();
		}
	}

	function drawAnchor() {
		// small overhead bracket for the cable to hang from
		ctx.strokeStyle = '#D7E6EF';
		ctx.lineWidth = 5;
		ctx.lineCap = 'round';
		ctx.beginPath();
		ctx.moveTo(ANCHOR.x - 26, ANCHOR.y + 8);
		ctx.lineTo(ANCHOR.x + 26, ANCHOR.y + 8);
		ctx.stroke();

		ctx.fillStyle = '#9AD8FF';
		ctx.beginPath();
		ctx.arc(ANCHOR.x, ANCHOR.y + 10, 5, 0, Math.PI * 2);
		ctx.fill();
	}

	function drawChain() {
		const topX = ANCHOR.x;
		const topY = ANCHOR.y + 12;
		const botX = ball.position.x;
		const botY = ball.position.y - BALL_RADIUS - 4;

		const dx = botX - topX;
		const dy = botY - topY;
		const dist = Math.hypot(dx, dy);
		if (dist < 2) return;
		const angle = Math.atan2(dy, dx);

		const count = Math.max(1, Math.round(dist / 11));

		for (let i = 0; i < count; i += 1) {
			const t = count === 1 ? 0.5 : i / (count - 1);
			const x = topX + dx * t;
			const y = topY + dy * t;

			ctx.save();
			ctx.translate(x, y);
			ctx.rotate(angle + (i % 2 === 1 ? Math.PI / 2 : 0));

			ctx.fillStyle = 'rgba(215, 230, 239, 0.28)';
			ctx.strokeStyle = 'rgba(215, 230, 239, 0.95)';
			ctx.lineWidth = 3;
			roundRectPath(ctx, -8, -5, 16, 10, 5);
			ctx.fill();
			ctx.stroke();

			ctx.restore();
		}
	}

	function drawBall() {
		const b = ball.position;
		const grad = ctx.createRadialGradient(b.x - 9, b.y - 11, 4, b.x, b.y, BALL_RADIUS + 4);
		grad.addColorStop(0, '#FFE08A');
		grad.addColorStop(0.5, '#FDB913');
		grad.addColorStop(1, '#A86506');

		ctx.beginPath();
		ctx.arc(b.x, b.y, BALL_RADIUS, 0, Math.PI * 2);
		ctx.fillStyle = grad;
		ctx.fill();
		ctx.lineWidth = 2;
		ctx.strokeStyle = 'rgba(9, 19, 28, 0.55)';
		ctx.stroke();

		// hook
		ctx.strokeStyle = '#E9F5FF';
		ctx.lineWidth = 3;
		ctx.lineCap = 'round';
		ctx.beginPath();
		ctx.moveTo(b.x, b.y - BALL_RADIUS - 2);
		ctx.lineTo(b.x, b.y - BALL_RADIUS - 12);
		ctx.stroke();
	}

	function drawCans() {
		for (const can of cans) {
			ctx.save();
			ctx.translate(can.position.x, can.position.y);
			ctx.rotate(can.angle);

			const grad = ctx.createLinearGradient(-CAN_W / 2, 0, CAN_W / 2, 0);
			grad.addColorStop(0, '#C9820E');
			grad.addColorStop(0.32, '#F7B32B');
			grad.addColorStop(0.7, '#F7B32B');
			grad.addColorStop(1, '#A86506');

			ctx.fillStyle = grad;
			roundRectPath(ctx, -CAN_W / 2, -CAN_H / 2, CAN_W, CAN_H, 14);
			ctx.fill();
			ctx.lineWidth = 2;
			ctx.strokeStyle = 'rgba(9, 19, 28, 0.6)';
			ctx.stroke();

			// top & bottom caps
			ctx.fillStyle = '#FFD54F';
			roundRectPath(ctx, -CAN_W / 2, -CAN_H / 2, CAN_W, 12, 6);
			ctx.fill();
			ctx.fillStyle = 'rgba(9, 19, 28, 0.35)';
			roundRectPath(ctx, -CAN_W / 2, CAN_H / 2 - 12, CAN_W, 12, 6);
			ctx.fill();

			// label band
			ctx.fillStyle = 'rgba(9, 19, 28, 0.82)';
			ctx.fillRect(-CAN_W / 2, -10, CAN_W, 20);
			ctx.fillStyle = '#F7B32B';
			ctx.font = 'bold 12px Inter, "Segoe UI", sans-serif';
			ctx.textAlign = 'center';
			ctx.textBaseline = 'middle';
			ctx.fillText('BIG', 0, 1);

			ctx.restore();
		}
	}

	function draw() {
		ctx.clearRect(0, 0, WORLD_W, WORLD_H);
		drawBackground();
		drawGround();
		drawAnchor();
		drawChain();
		drawCans();
		drawBall();
	}

	// ---- Game loop ----
	function updateScore() {
		for (const can of cans) {
			if (!knockedCans.has(can.id) && Math.abs(can.angle) > 0.45) {
				knockedCans.add(can.id);
			}
		}
		countEl.textContent = String(knockedCans.size);

		if (knockedCans.size === cans.length) {
			hintEl.textContent = 'Wall wrecked! Nice demolition.';
			hintEl.classList.add('is-win');
		} else {
			hintEl.textContent = 'Drag the ball to swing \u00b7 up and down to raise & lower';
			hintEl.classList.remove('is-win');
		}
	}

	function step() {
		rope.length = ropeLength;

		if (drag) {
			Sleeping.set(ball, false);
			// track the pointer horizontally with a clamped proportional gain;
			// the rigid cable keeps the ball on its swing arc.
			const dx = drag.px - ball.position.x;
			const vx = Math.max(-22, Math.min(22, dx * 0.6));
			Body.setVelocity(ball, { x: vx, y: ball.velocity.y * 0.5 });
		}

		Engine.update(engine, 1000 / 60);
		draw();
		updateScore();
		requestAnimationFrame(step);
	}

	// ---- Reset ----
	function resetGame() {
		// Park the ball at its resting height, then rebuild the can pyramid
		// so nothing overlaps during setup.
		ropeLength = ROPE_DEFAULT;
		rope.length = ropeLength;

		Body.setPosition(ball, { x: ANCHOR.x, y: ANCHOR.y + ropeLength });
		Body.setVelocity(ball, { x: 0, y: 0 });
		Body.setAngularVelocity(ball, 0);
		Body.setAngle(ball, 0);

		Composite.remove(engine.world, cans);
		cans = createCans();
		Composite.add(engine.world, cans);
		totalEl.textContent = String(cans.length);

		knockedCans.clear();
		countEl.textContent = '0';
	}

	resetBtn.addEventListener('click', resetGame);

	// ---- Init ----
	resize();
	if (typeof ResizeObserver !== 'undefined') {
		new ResizeObserver(resize).observe(canvas.parentElement as Element);
	} else {
		window.addEventListener('resize', resize);
	}

	requestAnimationFrame(step);
</script>

<style>
	.crane-game {
		margin-top: 28px;
	}

	.game-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		flex-wrap: wrap;
		gap: 20px;
		margin-bottom: 20px;
	}

	.game-copy {
		margin: 0;
		max-width: 600px;
		color: var(--muted);
		line-height: 1.6;
	}

	.game-ui {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 12px;
	}

	.score {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		line-height: 1.1;
	}

	.score-value {
		font-size: 2rem;
		font-weight: 900;
		letter-spacing: -0.03em;
		color: var(--accent);
	}

	.score-label {
		color: var(--muted);
		font-size: 0.85rem;
	}

	.reset-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 42px;
		padding: 0 18px;
		border: 1px solid rgba(154, 199, 226, 0.26);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.02);
		color: var(--text);
		font-weight: 700;
		font-size: 0.9rem;
		cursor: pointer;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.reset-button:hover {
		transform: translateY(-1px);
		border-color: var(--line);
		background: rgba(255, 255, 255, 0.06);
	}

	.game-stage {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		border: 1px solid var(--line);
		border-radius: 24px;
		background:
			radial-gradient(circle at 30% 15%, rgba(95, 195, 255, 0.18), transparent 45%),
			radial-gradient(circle at 80% 100%, rgba(253, 185, 19, 0.12), transparent 45%),
			#08131c;
		box-shadow: 0 28px 70px rgba(2, 5, 10, 0.5);
	}

	canvas {
		display: block;
		width: 100%;
		height: 100%;
		touch-action: none;
		user-select: none;
		-webkit-user-select: none;
	}

	.stage-hint {
		position: absolute;
		bottom: 14px;
		left: 50%;
		transform: translateX(-50%);
		margin: 0;
		padding: 8px 16px;
		font-size: 0.8rem;
		color: var(--muted);
		white-space: nowrap;
		background: rgba(9, 17, 24, 0.82);
		border: 1px solid var(--line);
		border-radius: 999px;
		pointer-events: none;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.stage-hint.is-active {
		color: var(--text);
		border-color: var(--secondary);
	}

	.stage-hint.is-win {
		color: var(--success);
		border-color: rgba(150, 242, 180, 0.5);
	}

	@media (max-width: 620px) {
		.game-ui {
			align-items: flex-start;
		}

		.stage-hint {
			white-space: normal;
			text-align: center;
			max-width: calc(100% - 32px);
		}
	}
</style>
