---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CraneGame3D from '../components/CraneGame3D.astro';
import Icon from '../components/Icon.astro';
// Imported (not referenced from /public) so Astro compresses it at build time.
import banner from '../assets/sixdeepbanner.jpg';
---

<Layout description="Six Deep Studios LLC is an independent game studio building physics-driven, fully destructible games. Big Time, our first project, is in prototype.">
	<div class="page-shell">
		<SiteHeader current="/" />

		<main id="home">
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Independent game studio</p>
					<h1 class="display">Building worlds <em>meant</em> to be broken.</h1>
					<p class="hero-sub">Feel your power through dynamic, real-time destruction.</p>
					<p class="lede">
						Six Deep Studios LLC is pushing the boundaries of in-game physics and object interaction. We engineer highly reactive, fully destructible environments optimized for allowing you to unleash absolute chaos without compromising on performance.
					</p>
					<div class="cta-row">
						<a class="primary-button" href="#play">
							<Icon name="play" size={18} />
							Play the demo
						</a>
						<a
							class="secondary-button"
							href="https://store.steampowered.com/"
							target="_blank"
							rel="noreferrer"
						>
							Steam — coming soon
						</a>
					</div>
					<ul class="stat-list" aria-label="Studio highlights">
						<li><strong>Now</strong><span>Prototype phase</span></li>
						<li><strong>Focus</strong><span>Games + systems</span></li>
						<li><strong>Vision</strong><span>Crafted worlds</span></li>
					</ul>
				</div>

				<div class="hero-art">
					<Picture
						src={banner}
						formats={['avif', 'webp']}
						widths={[480, 720, 1080, 1440]}
						sizes="(max-width: 900px) 92vw, 520px"
						alt="A construction site from Big Time, with a crane and stacked blocks — the world is your weapon."
						loading="eager"
						decoding="async"
					/>
				</div>
			</section>

			<!--
				The playable demo sits directly under the hero. It is the fastest way to show what
				"fully destructible" actually means, so it leads rather than trailing the copy.
			-->
			<section id="play" class="section reveal">
				<div class="section-heading">
					<p class="eyebrow">Playable now — no download</p>
					<h2>Try the tech behind Big Time</h2>
				</div>
				<p class="lede play-lede">
					This is a live Box3D physics sandbox rendered with three.js — the same engine
					that will drive Big Time's destruction. Swing the wrecking ball and flatten the
					wall.
				</p>
				<CraneGame3D />
				<div class="play-cta">
					<a class="secondary-button" href="/play-3d">Open the standalone demo</a>
				</div>
			</section>

			<section id="games" class="section reveal">
				<div class="section-heading">
					<p class="eyebrow">Featured game</p>
					<h2>Big Time</h2>
				</div>

				<article class="game-feature">
					<div class="game-feature-content">
						<p class="game-description">
							A physics-based fighting game where superheroes battle in a fully destructible world. Every object is a weapon, and the environment itself becomes part of the fight.
						</p>
						<div class="game-highlights">
							<span class="highlight"><Icon name="structure" size={18} /> Destructible worlds</span>
							<span class="highlight"><Icon name="impact" size={18} /> Physics-based combat</span>
							<span class="highlight"><Icon name="cube" size={18} /> Emergent gameplay</span>
						</div>
						<div class="cta-row cta-row--tight">
							<a class="primary-button" href="/big-time">Learn about Big Time</a>
						</div>
					</div>
				</article>
			</section>

			<section id="about" class="section reveal">
				<div class="section-heading">
					<p class="eyebrow">About us</p>
					<h2>A small team with a big ambition.</h2>
				</div>

				<div class="about-body">
					<p>
						Six Deep Studios LLC is a lean independent studio obsessed with physics-driven
						games. We believe the environment should be part of the fight — every wall a
						weapon, every structure a decision. <strong>Big Time</strong> is our first
						project: a superhero brawler set in fully destructible worlds where nothing is
						off-limits.
					</p>
				</div>

				<!--
					TODO (before launch): Alex's card is deliberately generic until the real facts
					are supplied. Add his job title and years, the school he studied at, and the two
					games he names, then restore "Alex studied game development at ___."
				-->
				<div class="team-grid">
					<article class="team-card">
						<div class="team-avatar" aria-hidden="true">AB</div>
						<p class="team-handle">AlienJim</p>
						<h3>Alex Burton</h3>
						<p class="team-role">Game design &amp; systems</p>
						<p class="team-bio">
							Alex is an avid gamer with a famously wide genre spread. That breadth of
							taste shows up in the systems and worlds he designs today — the rules that
							decide how a wall comes apart when you put a wrecking ball through it.
						</p>
					</article>

					<article class="team-card">
						<div class="team-avatar" aria-hidden="true">BM</div>
						<p class="team-handle">thebluegoatsings</p>
						<h3>Brian Maier</h3>
						<p class="team-role">B.S. in Information Technology · recent grad</p>
						<p class="team-bio">
							Brian is an equally avid gamer, and no game shaped him quite like
							<strong>Red Faction</strong> — he has craved that same granular, structural
							destruction ever since. Fresh off his bachelor's in IT, recent leaps in
							physics engines like <strong>Box3D</strong> are what finally made it possible
							to build the game he's always wanted — with Alex at his side.
						</p>
					</article>
				</div>

				<div class="cta-row">
					<a class="secondary-button" href="mailto:dev@sixdeepstudios.com">Contact us</a>
				</div>
			</section>

			<section id="steam" class="section steam-panel reveal">
				<div class="steam-content">
					<p class="eyebrow">Coming soon</p>
					<h2>Our Steam storefront is in progress.</h2>
					<p>
						A dedicated store page is on the roadmap. Until then, this placeholder links
						to the broader Steam marketplace while we prepare the first release.
					</p>
					<div class="cta-row">
						<a
							class="primary-button"
							href="https://store.steampowered.com/"
							target="_blank"
							rel="noreferrer"
						>
							Visit Steam placeholder
						</a>
					</div>
				</div>
				<div class="steam-art">
					<img
						src="/under-construction-crane.svg"
						alt=""
						aria-hidden="true"
						width="1200"
						height="920"
						loading="lazy"
						decoding="async"
					/>
				</div>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		align-items: center;
		gap: 36px;
		padding: 36px 0 48px;
	}

	.hero-copy h1 em {
		font-style: normal;
		color: var(--accent);
	}

	/* The supporting headline under the h1 — big, yellow, not a full heading level. */
	.hero-sub {
		margin: 14px 0 0;
		font-size: clamp(1.05rem, 1.6vw, 1.35rem);
		font-weight: 800;
		letter-spacing: -0.01em;
		color: var(--accent);
	}

	.stat-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(120px, 1fr));
		gap: 16px;
		margin: 36px 0 0;
		padding: 0;
		list-style: none;
	}

	.stat-list li {
		padding: 18px 16px;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: rgba(9, 17, 24, 0.5);
		backdrop-filter: blur(10px);
	}

	.stat-list strong {
		display: block;
		margin-bottom: 6px;
		font-size: 1rem;
	}

	.stat-list span {
		color: var(--muted);
		font-size: 0.85rem;
	}

	.hero-art {
		padding: 14px;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: linear-gradient(180deg, rgba(13, 24, 34, 0.82), rgba(9, 16, 25, 0.96));
		box-shadow: var(--shadow-panel);
	}

	/* <Picture> renders its own <img>, which carries no scope class — hence :global(). */
	.hero-art :global(img) {
		width: 100%;
		height: auto;
		border-radius: 16px;
	}

	.play-lede {
		margin-bottom: 4px;
	}

	.play-cta {
		margin-top: 24px;
	}

	.game-feature {
		padding: 32px 28px;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: linear-gradient(135deg, rgba(114, 212, 255, 0.08), rgba(253, 185, 19, 0.06));
	}

	.game-feature-content {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.game-description {
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.6;
		color: var(--muted);
	}

	.game-highlights {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	/* Icon chips, replacing the old plain-text pills. */
	.highlight {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		padding: 9px 16px;
		border: 1px solid rgba(114, 212, 255, 0.35);
		border-radius: 999px;
		font-size: 0.88rem;
		color: #bfe6ff;
		background: rgba(114, 212, 255, 0.09);
	}

	.highlight :global(.icon) {
		color: var(--secondary);
	}

	.cta-row--tight {
		margin-top: 4px;
	}

	.about-body {
		max-width: 760px;
	}

	.about-body p {
		margin: 0;
		font-size: 1.12rem;
		line-height: 1.7;
		color: var(--muted);
	}

	.about-body strong {
		color: var(--text);
	}

	.team-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px;
		margin-top: 40px;
	}

	.team-card {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 28px 24px;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: linear-gradient(180deg, rgba(13, 24, 34, 0.8), rgba(9, 16, 25, 0.92));
		box-shadow: var(--shadow-card);
	}

	.team-avatar {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 60px;
		height: 60px;
		margin-bottom: 6px;
		border-radius: 50%;
		font-size: 1.15rem;
		font-weight: 900;
		letter-spacing: 0.04em;
		color: #141a21;
		background: linear-gradient(135deg, var(--accent), #ffc968);
		box-shadow: 0 10px 22px rgba(253, 185, 19, 0.22);
	}

	.team-card:nth-child(2) .team-avatar {
		color: #0a151d;
		background: linear-gradient(135deg, var(--secondary), #a8d9ff);
		box-shadow: 0 10px 22px rgba(95, 195, 255, 0.2);
	}

	.team-handle {
		margin: 0 0 2px;
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.team-card h3 {
		margin: 0;
		font-size: 1.45rem;
		letter-spacing: -0.02em;
	}

	.team-role {
		margin: 2px 0 0;
		font-size: 0.85rem;
		color: var(--muted);
	}

	.team-bio {
		margin: 8px 0 0;
		font-size: 0.98rem;
		line-height: 1.65;
		color: var(--muted);
	}

	.team-bio strong {
		color: var(--text);
	}

	/*
		The under-construction crane illustration finally has a job: it frames the one
		section that is genuinely still being built.
	*/
	.steam-panel {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		align-items: center;
		gap: 32px;
		padding: 28px;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: rgba(9, 17, 24, 0.8);
	}

	.steam-panel h2 {
		margin: 0;
		font-size: clamp(1.7rem, 3.2vw, 2.5rem);
		letter-spacing: -0.05em;
	}

	.steam-content p {
		margin: 14px 0 0;
		max-width: 560px;
		color: var(--muted);
	}

	.steam-content .cta-row {
		margin-top: 24px;
	}

	.steam-art {
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: #09131c;
	}

	.steam-art img {
		width: 100%;
		height: auto;
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
		}

		.team-grid {
			grid-template-columns: 1fr;
		}

		.steam-panel {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 620px) {
		.stat-list {
			grid-template-columns: 1fr;
		}
	}
</style>
