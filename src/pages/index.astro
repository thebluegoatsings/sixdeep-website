---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
	<div class="page-shell">
		<header class="topbar">
			<div class="brand-block">
				<div class="brand-mark">
					<span class="brand-text-mark">6D</span>
					<span class="brand-text-mark">STUDIOS</span>
				</div>
			</div>
			<nav class="nav" aria-label="Main navigation">
				<a href="#home">Home</a>
				<a href="/big-time">Big Time</a>
				<a href="#about">About</a>
				<a href="#steam">Steam</a>
			</nav>
		</header>

		<main id="home">
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Independent game studio</p>
					<h1>Building worlds <em>meant</em> to be broken. <span class="accent-text">Feel your power through dynamic, real-time destruction.</span></h1>
					<p class="lede">
						Six Deep Studios LLC is pushing the boundaries of in-game physics and object interaction. We engineer highly reactive, fully destructible environments optimized for allowing you to unleash absolute chaos without compromising on performance.
					</p>
					<div class="cta-row">
						<a class="primary-button" href="https://store.steampowered.com/" target="_blank" rel="noreferrer">
							Steam coming soon
						</a>
						<a class="secondary-button" href="#about">Meet the team</a>
					</div>
					<ul class="stat-list" aria-label="Studio highlights">
						<li><strong>Now</strong><span>Prototype phase</span></li>
						<li><strong>Focus</strong><span>Games + systems</span></li>
						<li><strong>Vision</strong><span>Crafted worlds</span></li>
					</ul>
				</div>

			<div class="hero-art" aria-label="Big Time Smasher construction site with crane">
				<img src="/sixdeepbanner.jpg" alt="Six Deep Studios Big Time construction site - The World Is Your Weapon" />
				</div>
			</section>

			<section id="games" class="games-section">
				<div class="section-heading">
					<p class="eyebrow">Featured game</p>
					<h2>Big Time</h2>
				</div>

				<article class="game-feature">
					<div class="game-feature-content">
						<p class="game-description">
							A physics-based fighting game where superheroes battle in a fully destructible world. Every object is a weapon, and the environment itself becomes part of the fight.
						</p>
						<div class="game-highlights">
							<span class="highlight">Destructible Worlds</span>
							<span class="highlight">Physics-Based Combat</span>
							<span class="highlight">Dynamic Gameplay</span>
						</div>
						<a class="secondary-button" href="/big-time">Learn more</a>
					</div>
				</article>
			</section>

			<section id="about" class="about-section">
				<div class="section-heading">
					<p class="eyebrow">About us</p>
					<h2>A small team with a big ambition.</h2>
				</div>

				<div class="team-grid">
					<article class="member-card">
						<div class="avatar">AD</div>
						<h3>Aiden Drake</h3>
						<p class="role">Creative Director</p>
						<p>
							Shapes the artistic direction and leading vision behind every experience.
						</p>
					</article>

					<article class="member-card">
						<div class="avatar">MS</div>
						<h3>Mira Sol</h3>
						<p class="role">Design Lead</p>
						<p>
							Builds playful systems and memorable interactions that keep players invested.
						</p>
					</article>

					<article class="member-card">
						<div class="avatar">JL</div>
						<h3>Jonah Lee</h3>
						<p class="role">Technical Director</p>
						<p>
							Turns ambitious concepts into stable foundations and scalable product pipelines.
						</p>
					</article>
				</div>
			</section>

			<section id="steam" class="steam-panel">
				<p class="eyebrow">Coming soon</p>
				<h2>Our Steam storefront is in progress.</h2>
				<p>
					A dedicated store page is on the roadmap. Until then, this placeholder links to the broader Steam
					marketplace while we prepare the first release.
				</p>
				<a class="primary-button" href="https://store.steampowered.com/" target="_blank" rel="noreferrer">
					Visit Steam placeholder
				</a>
			</section>
		</main>
	</div>
</Layout>

<style>
	.page-shell {
		max-width: 1200px;
		margin: 0 auto;
		padding: 32px 24px 72px;
	}

	.topbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 8px 0 24px;
	}

	.brand-block {
		display: inline-flex;
		align-items: center;
		gap: 12px;
	}

	.brand-mark {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 80px;
		height: 80px;
		border-radius: 12px;
		background: #0a1118;
		border: 2px solid rgba(95, 195, 255, 0.4);
		color: #fff;
		font-weight: 900;
		line-height: 0.9;
		gap: 4px;
		text-align: center;
	}

	.brand-text-mark {
		display: block;
		text-transform: uppercase;
	}

	.brand-text-mark:first-child {
		font-size: 2.4rem;
		font-weight: 900;
		letter-spacing: -0.05em;
	}

	.brand-text-mark:last-child {
		font-size: 0.55rem;
		letter-spacing: 0.12em;
		font-weight: 900;
	}

	.brand-text {
		font-size: 0.96rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.nav {
		display: flex;
		gap: 28px;
		font-size: 0.95rem;
		color: var(--muted);
	}

	.nav a {
		transition: color 0.2s ease;
	}

	.nav a:hover {
		color: var(--text);
	}

	.hero {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		align-items: center;
		gap: 36px;
		padding: 36px 0 48px;
	}

	.eyebrow {
		margin: 0 0 12px;
		font-size: 0.75rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.hero-copy h1 {
		margin: 0;
		font-size: clamp(2.9rem, 6vw, 5.2rem);
		line-height: 0.95;
		letter-spacing: -0.06em;
	}

	.hero-copy h1 .accent-text {
		color: var(--accent);
		font-size: 0.85em;
	}

	.lede {
		max-width: 630px;
		margin-top: 20px;
		font-size: 1.08rem;
		color: var(--muted);
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		margin-top: 28px;
	}

	.primary-button,
	.secondary-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		padding: 0 20px;
		border-radius: 999px;
		font-weight: 700;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}

	.primary-button {
		background: linear-gradient(135deg, var(--accent), #ffc968);
		color: #141a21;
		box-shadow: 0 18px 30px rgba(247, 179, 43, 0.25);
	}

	.secondary-button {
		border: 1px solid rgba(154, 199, 226, 0.26);
		background: rgba(255, 255, 255, 0.02);
		color: var(--text);
	}

	.primary-button:hover,
	.secondary-button:hover {
		transform: translateY(-1px);
	}

	.stat-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(120px, 1fr));
		gap: 16px;
		margin: 36px 0 0;
		padding: 0;
		list-style: none;
	}

	.stat-list li {
		padding: 18px 16px;
		border: 1px solid var(--line);
		border-radius: 18px;
		background: rgba(9, 17, 24, 0.5);
		backdrop-filter: blur(10px);
	}

	.stat-list strong {
		display: block;
		margin-bottom: 6px;
		font-size: 1rem;
	}

	.stat-list span {
		color: var(--muted);
		font-size: 0.85rem;
	}

	.hero-art {
		position: relative;
		padding: 18px;
		border: 1px solid var(--line);
		border-radius: 28px;
		background: linear-gradient(180deg, rgba(13, 24, 34, 0.82), rgba(9, 16, 25, 0.96));
		box-shadow: 0 28px 70px rgba(2, 5, 10, 0.5);
	}

	.hero-art img {
		width: 100%;
		height: auto;
		border-radius: 16px;
	}

	.games-section,
	.about-section,
	.steam-panel {
		margin-top: 60px;
		padding-top: 32px;
		border-top: 1px solid var(--line);
	}

	.game-feature {
		padding: 32px 24px;
		border: 1px solid var(--line);
		border-radius: 28px;
		background: linear-gradient(135deg, rgba(114, 212, 255, 0.08), rgba(247, 179, 43, 0.06));
	}

	.game-feature-content {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.game-description {
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.6;
		color: var(--muted);
	}

	.game-highlights {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.highlight {
		display: inline-block;
		padding: 8px 16px;
		border: 1px solid rgba(114, 212, 255, 0.4);
		border-radius: 999px;
		font-size: 0.85rem;
		color: rgba(114, 212, 255, 0.8);
		background: rgba(114, 212, 255, 0.1);
	}

	.section-heading {
		margin-bottom: 24px;
	}

	.section-heading h2,
	.steam-panel h2 {
		margin: 0;
		font-size: clamp(2rem, 4vw, 3rem);
		letter-spacing: -0.05em;
	}

	.team-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
	}

	.member-card {
		padding: 24px 20px;
		border: 1px solid var(--line);
		border-radius: 22px;
		background: rgba(10, 18, 26, 0.75);
	}

	.avatar {
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		margin-bottom: 18px;
		border-radius: 50%;
		background: linear-gradient(135deg, rgba(114, 212, 255, 0.28), rgba(247, 179, 43, 0.24));
		font-weight: 800;
		color: var(--text);
	}

	.member-card h3 {
		margin: 0 0 4px;
		font-size: 1.2rem;
	}

	.role {
		margin: 0 0 10px;
		color: var(--secondary);
		font-weight: 700;
	}

	.member-card p:last-child {
		margin: 0;
		color: var(--muted);
	}

	.steam-panel {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
		padding: 28px 24px;
		border: 1px solid var(--line);
		border-radius: 28px;
		background: rgba(9, 17, 24, 0.8);
	}

	.steam-panel p {
		margin: 0;
		color: var(--muted);
		max-width: 720px;
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
		}

		.team-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 620px) {
		.page-shell {
			padding-left: 18px;
			padding-right: 18px;
		}

		.topbar {
			flex-direction: column;
			align-items: flex-start;
			gap: 16px;
		}

		.nav {
			gap: 16px;
			flex-wrap: wrap;
		}

		.stat-list {
			grid-template-columns: 1fr;
		}
	}
</style>
