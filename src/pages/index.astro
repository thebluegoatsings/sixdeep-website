---
import Layout from '../layouts/Layout.astro';
import CraneGame3D from '../components/CraneGame3D.astro';
---

<Layout title="Home">
	<div class="page-shell">
		<header class="topbar">
			<div class="brand-block">
				<img class="brand-mark" src="/logo.svg" alt="Six Deep Studios" width="80" height="80" />
			</div>
			<nav class="nav" aria-label="Main navigation">
				<a href="#home">Home</a>
				<a href="/big-time">Big Time</a>
				<a href="#play">Play demo</a>
				<a href="#about">About</a>
				<a href="#steam">Steam</a>
			</nav>
		</header>

		<main id="home">
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Independent game studio</p>
					<h1>Building worlds <em>meant</em> to be broken. <span class="accent-text">Feel your power through dynamic, real-time destruction.</span></h1>
					<p class="lede">
						Six Deep Studios LLC is pushing the boundaries of in-game physics and object interaction. We engineer highly reactive, fully destructible environments optimized for allowing you to unleash absolute chaos without compromising on performance.
					</p>
					<div class="cta-row">
						<a class="primary-button" href="https://store.steampowered.com/" target="_blank" rel="noreferrer">
							Steam coming soon
						</a>
						<a class="secondary-button" href="#about">About the studio</a>
					</div>
					<ul class="stat-list" aria-label="Studio highlights">
						<li><strong>Now</strong><span>Prototype phase</span></li>
						<li><strong>Focus</strong><span>Games + systems</span></li>
						<li><strong>Vision</strong><span>Crafted worlds</span></li>
					</ul>
				</div>

			<div class="hero-art" aria-label="Big Time Smasher construction site with crane">
				<img src="/sixdeepbanner.jpg" alt="Six Deep Studios Big Time construction site - The World Is Your Weapon" />
				</div>
			</section>

			<section id="games" class="games-section">
				<div class="section-heading">
					<p class="eyebrow">Featured game</p>
					<h2>Big Time</h2>
				</div>

				<article class="game-feature">
					<div class="game-feature-content">
						<p class="game-description">
							A physics-based fighting game where superheroes battle in a fully destructible world. Every object is a weapon, and the environment itself becomes part of the fight.
						</p>
						<div class="game-highlights">
							<span class="highlight">Destructible Worlds</span>
							<span class="highlight">Physics-Based Combat</span>
							<span class="highlight">Dynamic Gameplay</span>
						</div>
						<a class="secondary-button" href="/big-time">Learn more</a>
					</div>
				</article>
			</section>

			<section id="play" class="play-section">
				<div class="section-heading">
					<p class="eyebrow">Tech demo</p>
					<h2>Box3D in action — a demo!</h2>
				</div>
				<CraneGame3D />
				<div class="play-cta">
					<a class="secondary-button" href="/play-3d">Open in full screen</a>
				</div>
			</section>

			<section id="about" class="about-section">
				<div class="section-heading">
					<p class="eyebrow">About us</p>
					<h2>A small team with a big ambition.</h2>
				</div>

				<div class="about-body">
					<p>
						Six Deep Studios LLC is a lean independent studio obsessed with physics-driven
						games. We believe the environment should be part of the fight — every wall a
						weapon, every structure a decision. <strong>Big Time</strong> is our first
						project: a superhero brawler set in fully destructible worlds where nothing is
						off-limits.
					</p>
				</div>

				<!-- TODO: Fill in Alex's placeholders below: [school], [job title · years], [inspiring games] -->
				<div class="team-grid">
					<article class="team-card">
						<div class="team-avatar" aria-hidden="true">AB</div>
						<p class="team-handle">AlienJim</p>
						<h3>Alex Burton</h3>
						<p class="team-role">[Job title] · [N]+ years</p>
						<p class="team-bio">
							Alex studied game development at [school]. An avid gamer who loves a very
							wide genre spread, he grew up on everything from [game one] to [game two]
							— and that breadth of taste shows up in the systems and worlds he designs
							today.
						</p>
					</article>

					<article class="team-card">
						<div class="team-avatar" aria-hidden="true">BM</div>
						<p class="team-handle">thebluegoatsings</p>
						<h3>Brian Maier</h3>
						<p class="team-role">B.S. in Information Technology · recent grad</p>
						<p class="team-bio">
							Brian is an equally avid gamer, and no game shaped him quite like
							<strong>Red Faction</strong> — he has craved that same granular, structural
							destruction ever since. Fresh off his bachelor's in IT, recent leaps in
							physics engines like <strong>Box3D</strong> are what finally made it possible
							to build the game he's always wanted — with Alex at his side.
						</p>
					</article>
				</div>

				<div class="cta-row">
					<a class="primary-button" href="/big-time">Learn about Big Time</a>
					<a class="secondary-button" href="mailto:dev@sixdeepstudios.com">Contact us</a>
				</div>
			</section>

			<section id="steam" class="steam-panel">
				<p class="eyebrow">Coming soon</p>
				<h2>Our Steam storefront is in progress.</h2>
				<p>
					A dedicated store page is on the roadmap. Until then, this placeholder links to the broader Steam
					marketplace while we prepare the first release.
				</p>
				<a class="primary-button" href="https://store.steampowered.com/" target="_blank" rel="noreferrer">
					Visit Steam placeholder
				</a>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-email-block">
				<p class="footer-label">Get in touch</p>
				<a class="footer-email" href="mailto:dev@sixdeepstudios.com">dev@sixdeepstudios.com</a>
			</div>
			<nav class="footer-nav" aria-label="Footer navigation">
				<a href="/">Home</a>
				<a href="/big-time">Big Time</a>
				<a href="/play-3d">3D prototype</a>
				<a href="#about">About</a>
			</nav>
			<p class="footer-legal">© 2026 Six Deep Studios LLC. All rights reserved.</p>
		</footer>
	</div>
</Layout>

<style>
	.page-shell {
		max-width: 1200px;
		margin: 0 auto;
		padding: 32px 24px 72px;
	}

	.topbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 8px 0 24px;
	}

	.brand-block {
		display: inline-flex;
		align-items: center;
		gap: 12px;
	}

	.brand-mark {
		display: block;
		width: 80px;
		height: 80px;
	}

	.brand-text {
		font-size: 0.96rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.nav {
		display: flex;
		gap: 28px;
		font-size: 0.95rem;
		color: var(--muted);
	}

	.nav a {
		transition: color 0.2s ease;
	}

	.nav a:hover {
		color: var(--text);
	}

	.hero {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		align-items: center;
		gap: 36px;
		padding: 36px 0 48px;
	}

	.eyebrow {
		margin: 0 0 12px;
		font-size: 0.75rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.hero-copy h1 {
		margin: 0;
		font-size: clamp(2.9rem, 6vw, 5.2rem);
		line-height: 0.95;
		letter-spacing: -0.06em;
	}

	.hero-copy h1 .accent-text {
		color: var(--accent);
		font-size: 0.85em;
	}

	.lede {
		max-width: 630px;
		margin-top: 20px;
		font-size: 1.08rem;
		color: var(--muted);
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		margin-top: 28px;
	}

	.primary-button,
	.secondary-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		padding: 0 20px;
		border-radius: 999px;
		font-weight: 700;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}

	.primary-button {
		background: linear-gradient(135deg, var(--accent), #ffc968);
		color: #141a21;
		box-shadow: 0 18px 30px rgba(247, 179, 43, 0.25);
	}

	.secondary-button {
		border: 1px solid rgba(154, 199, 226, 0.26);
		background: rgba(255, 255, 255, 0.02);
		color: var(--text);
	}

	.primary-button:hover,
	.secondary-button:hover {
		transform: translateY(-1px);
	}

	.stat-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(120px, 1fr));
		gap: 16px;
		margin: 36px 0 0;
		padding: 0;
		list-style: none;
	}

	.stat-list li {
		padding: 18px 16px;
		border: 1px solid var(--line);
		border-radius: 18px;
		background: rgba(9, 17, 24, 0.5);
		backdrop-filter: blur(10px);
	}

	.stat-list strong {
		display: block;
		margin-bottom: 6px;
		font-size: 1rem;
	}

	.stat-list span {
		color: var(--muted);
		font-size: 0.85rem;
	}

	.hero-art {
		position: relative;
		padding: 18px;
		border: 1px solid var(--line);
		border-radius: 28px;
		background: linear-gradient(180deg, rgba(13, 24, 34, 0.82), rgba(9, 16, 25, 0.96));
		box-shadow: 0 28px 70px rgba(2, 5, 10, 0.5);
	}

	.hero-art img {
		width: 100%;
		height: auto;
		border-radius: 16px;
	}

	.games-section,
	.about-section,
	.steam-panel,
	.play-section {
		margin-top: 60px;
		padding-top: 32px;
		border-top: 1px solid var(--line);
	}

	.play-cta {
		margin-top: 24px;
	}

	.game-feature {
		padding: 32px 24px;
		border: 1px solid var(--line);
		border-radius: 28px;
		background: linear-gradient(135deg, rgba(114, 212, 255, 0.08), rgba(247, 179, 43, 0.06));
	}

	.game-feature-content {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.game-description {
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.6;
		color: var(--muted);
	}

	.game-highlights {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.highlight {
		display: inline-block;
		padding: 8px 16px;
		border: 1px solid rgba(114, 212, 255, 0.4);
		border-radius: 999px;
		font-size: 0.85rem;
		color: rgba(114, 212, 255, 0.8);
		background: rgba(114, 212, 255, 0.1);
	}

	.section-heading {
		margin-bottom: 24px;
	}

	.section-heading h2,
	.steam-panel h2 {
		margin: 0;
		font-size: clamp(2rem, 4vw, 3rem);
		letter-spacing: -0.05em;
	}

	.about-body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 24px;
		max-width: 760px;
	}

	.about-body p {
		margin: 0;
		font-size: 1.12rem;
		line-height: 1.7;
		color: var(--muted);
	}

	.about-body strong {
		color: var(--text);
	}

	.team-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px;
		margin-top: 40px;
	}

	.team-card {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 28px 24px;
		border: 1px solid var(--line);
		border-radius: 28px;
		background: linear-gradient(180deg, rgba(13, 24, 34, 0.8), rgba(9, 16, 25, 0.92));
		box-shadow: 0 20px 44px rgba(2, 5, 10, 0.35);
	}

	.team-avatar {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 60px;
		height: 60px;
		margin-bottom: 6px;
		border-radius: 50%;
		font-size: 1.15rem;
		font-weight: 900;
		letter-spacing: 0.04em;
		color: #141a21;
		background: linear-gradient(135deg, var(--accent), #ffc968);
		box-shadow: 0 10px 22px rgba(247, 179, 43, 0.22);
	}

	.team-card:nth-child(2) .team-avatar {
		color: #0a151d;
		background: linear-gradient(135deg, var(--secondary), #a8d9ff);
		box-shadow: 0 10px 22px rgba(95, 195, 255, 0.2);
	}

	.team-handle {
		margin: 0 0 2px;
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.team-card h3 {
		margin: 0;
		font-size: 1.45rem;
		letter-spacing: -0.02em;
	}

	.team-role {
		margin: 2px 0 0;
		font-size: 0.85rem;
		color: var(--muted);
	}

	.team-bio {
		margin: 8px 0 0;
		font-size: 0.98rem;
		line-height: 1.65;
		color: var(--muted);
	}

	.team-bio strong {
		color: var(--text);
	}

	.site-footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 20px 32px;
		margin-top: 72px;
		padding-top: 28px;
		border-top: 1px solid var(--line);
	}

	.footer-email-block {
		display: flex;
		flex-direction: column;
	}

	.footer-label {
		margin: 0 0 4px;
		font-size: 0.75rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.footer-email {
		font-weight: 800;
		font-size: 1.05rem;
		color: var(--secondary);
	}

	.footer-email:hover {
		color: var(--text);
	}

	.footer-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		font-size: 0.92rem;
		color: var(--muted);
	}

	.footer-nav a:hover {
		color: var(--text);
	}

	.footer-legal {
		margin: 0;
		font-size: 0.85rem;
		color: var(--muted);
	}

	.steam-panel {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
		padding: 28px 24px;
		border: 1px solid var(--line);
		border-radius: 28px;
		background: rgba(9, 17, 24, 0.8);
	}

	.steam-panel p {
		margin: 0;
		color: var(--muted);
		max-width: 720px;
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
		}

		.team-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 620px) {
		.page-shell {
			padding-left: 18px;
			padding-right: 18px;
		}

		.topbar {
			flex-direction: column;
			align-items: flex-start;
			gap: 16px;
		}

		.nav {
			gap: 16px;
			flex-wrap: wrap;
		}

		.stat-list {
			grid-template-columns: 1fr;
		}
	}
</style>
