---
import Layout from '../layouts/Layout.astro';
import CraneGame3D from '../components/CraneGame3D.astro';
---

<Layout title="Wrecking Ball 3D">
	<div class="page-shell">
		<header class="topbar">
			<div class="brand-block">
				<a href="/" class="logo-link">
					<img class="brand-mark" src="/logo.svg" alt="Six Deep Studios" width="80" height="80" />
				</a>
			</div>
			<nav class="nav" aria-label="Main navigation">
				<a href="/">Home</a>
				<a href="/big-time">Big Time</a>
			</nav>
		</header>

		<main id="play">
			<section class="play-section">
				<div class="section-heading">
					<p class="eyebrow">Tech demo</p>
					<h1>Box3D in action — a demo!</h1>
				</div>
				<p class="lede">
					A full-screen demo of Erin Catto's Box3D physics engine, rendered with three.js —
					a look at the real-time destruction Big Time will be built on.
				</p>
				<CraneGame3D />
			</section>
		</main>
	</div>
</Layout>

<style>
	.page-shell {
		max-width: 1200px;
		margin: 0 auto;
		padding: 32px 24px 72px;
	}

	.topbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 8px 0 24px;
	}

	.brand-block {
		display: inline-flex;
		align-items: center;
		gap: 12px;
	}

	.brand-mark {
		display: block;
		width: 80px;
		height: 80px;
	}

	.logo-link {
		text-decoration: none;
		display: flex;
		align-items: center;
	}

	.nav {
		display: flex;
		gap: 28px;
		font-size: 0.95rem;
		color: var(--muted);
	}

	.nav a:hover {
		color: var(--text);
	}

	.play-section {
		margin-top: 8px;
	}

	.section-heading {
		margin-bottom: 16px;
	}

	.eyebrow {
		margin: 0 0 12px;
		font-size: 0.75rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.section-heading h1 {
		margin: 0;
		font-size: clamp(2.4rem, 5vw, 4rem);
		line-height: 1;
		letter-spacing: -0.05em;
	}

	.lede {
		max-width: 720px;
		margin: 16px 0 0;
		font-size: 1.08rem;
		color: var(--muted);
	}

	@media (max-width: 620px) {
		.page-shell {
			padding-left: 18px;
			padding-right: 18px;
		}

		.topbar {
			flex-direction: column;
			align-items: flex-start;
			gap: 16px;
		}

		.nav {
			gap: 16px;
			flex-wrap: wrap;
		}
	}
</style>
