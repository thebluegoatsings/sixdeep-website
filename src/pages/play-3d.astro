---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CraneGame3D from '../components/CraneGame3D.astro';
---

<Layout
	title="Wrecking Ball demo"
	description="Play the Six Deep Studios physics tech demo in your browser — a wrecking-ball sandbox built on Erin Catto's Box3D and rendered with three.js."
>
	<div class="page-shell">
		<SiteHeader current="/play-3d" />

		<main id="play">
			<section class="play-section">
				<div class="section-heading">
					<p class="eyebrow">Tech demo</p>
					<h1>Box3D in action — a demo!</h1>
				</div>
				<p class="lede">
					A live demo of Erin Catto's Box3D physics engine, rendered with three.js — a look
					at the real-time destruction Big Time will be built on. Desktop only for now: the
					controls need a keyboard.
				</p>
				<CraneGame3D />
				<p class="play-note">
					Want the story first? <a href="/big-time">See what we're building with it</a>.
				</p>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>

<style>
	/*
		The demo is the entire point of this page, so it gets a wider shell than the rest of
		the site and the canvas grows with it.
	*/
	.page-shell {
		max-width: 1440px;
	}

	.play-section {
		margin-top: 8px;
	}

	.section-heading {
		margin-bottom: 16px;
	}

	.section-heading h1 {
		margin: 0;
		font-size: clamp(2.4rem, 5vw, 4rem);
		line-height: 1;
		letter-spacing: -0.05em;
	}

	.lede {
		max-width: 720px;
		margin: 16px 0 0;
	}

	.play-note {
		margin: 24px 0 0;
		font-size: 0.95rem;
		color: var(--muted);
	}

	.play-note a {
		font-weight: 700;
		color: var(--secondary);
	}

	.play-note a:hover {
		color: var(--text);
	}
</style>
