---
import Layout from '../layouts/Layout.astro';
import CraneGame3D from '../components/CraneGame3D.astro';
---

<Layout title="Wrecking Ball 3D">
	<div class="page-shell">
		<header class="topbar">
			<div class="brand-block">
				<a href="/" class="logo-link">
					<div class="brand-mark">
						<span class="brand-text-mark">6D</span>
						<span class="brand-text-mark">STUDIOS</span>
					</div>
				</a>
			</div>
			<nav class="nav" aria-label="Main navigation">
				<a href="/">Home</a>
				<a href="/big-time">Big Time</a>
			</nav>
		</header>

		<main id="play">
			<section class="play-section">
				<div class="section-heading">
					<p class="eyebrow">3D prototype</p>
					<h1>Wrecking ball on Box3D</h1>
				</div>
				<p class="lede">
					The same game in 3D, running on Erin Catto's Box3D physics engine rendered with
					three.js. Rotate the crane with A/D and raise or lower the ball with W/S.
				</p>
				<CraneGame3D />
			</section>
		</main>
	</div>
</Layout>

<style>
	.page-shell {
		max-width: 1200px;
		margin: 0 auto;
		padding: 32px 24px 72px;
	}

	.topbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 8px 0 24px;
	}

	.brand-block {
		display: inline-flex;
		align-items: center;
		gap: 12px;
	}

	.brand-mark {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 80px;
		height: 80px;
		border-radius: 12px;
		background: #0a1118;
		border: 2px solid rgba(95, 195, 255, 0.4);
		color: #fff;
		font-weight: 900;
		line-height: 0.9;
		gap: 4px;
		text-align: center;
	}

	.brand-text-mark {
		display: block;
		text-transform: uppercase;
	}

	.brand-text-mark:first-child {
		font-size: 2.4rem;
		font-weight: 900;
		letter-spacing: -0.05em;
	}

	.brand-text-mark:last-child {
		font-size: 0.55rem;
		letter-spacing: 0.12em;
		font-weight: 900;
	}

	.logo-link {
		text-decoration: none;
		display: flex;
		align-items: center;
	}

	.nav {
		display: flex;
		gap: 28px;
		font-size: 0.95rem;
		color: var(--muted);
	}

	.nav a:hover {
		color: var(--text);
	}

	.play-section {
		margin-top: 8px;
	}

	.section-heading {
		margin-bottom: 16px;
	}

	.eyebrow {
		margin: 0 0 12px;
		font-size: 0.75rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.section-heading h1 {
		margin: 0;
		font-size: clamp(2.4rem, 5vw, 4rem);
		line-height: 1;
		letter-spacing: -0.05em;
	}

	.lede {
		max-width: 720px;
		margin: 16px 0 0;
		font-size: 1.08rem;
		color: var(--muted);
	}

	@media (max-width: 620px) {
		.page-shell {
			padding-left: 18px;
			padding-right: 18px;
		}

		.topbar {
			flex-direction: column;
			align-items: flex-start;
			gap: 16px;
		}

		.nav {
			gap: 16px;
			flex-wrap: wrap;
		}
	}
</style>
