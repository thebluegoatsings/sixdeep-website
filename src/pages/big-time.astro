---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';
---

<Layout
	title="Big Time"
	description="Big Time is a physics-based superhero fighting game where the world itself becomes your weapon. Battle in fully destructible environments where every object can be grabbed, thrown and demolished in real time."
>
	<div class="page-shell">
		<SiteHeader current="/big-time" />

		<main id="game">
			<section class="game-hero">
				<div class="hero-copy">
					<p class="eyebrow">Featured game</p>
					<h1 class="display">Big Time</h1>
					<p class="hero-sub">The world is your weapon.</p>
					<p class="lede">
						A physics-based superhero fighting game where the world itself becomes your weapon. 
						Battle in fully destructible environments where every object can be grabbed, thrown, 
						and demolished in real-time.
					</p>
					<div class="cta-row">
						<a class="primary-button" href="https://store.steampowered.com/" target="_blank" rel="noreferrer">
							Wishlist on Steam
						</a>
						<a class="secondary-button" href="/#play">Play the tech demo</a>
					</div>
				</div>
			</section>

			<section class="section reveal">
				<div class="section-heading">
					<p class="eyebrow">Game features</p>
					<h2>Destruction at your fingertips</h2>
				</div>

				<div class="features-grid">
					<article class="feature-card">
						<div class="feature-icon"><Icon name="impact" size={26} /></div>
						<h3>Physics-Based Combat</h3>
						<p>
							Every punch, kick, and collision is simulated in real-time. Master momentum, 
							weight, and impact to dominate your opponent.
						</p>
					</article>

					<article class="feature-card">
						<div class="feature-icon"><Icon name="structure" size={26} /></div>
						<h3>Destructible Worlds</h3>
						<p>
							Nothing is off-limits. Buildings crumble, streets crack, and entire environments 
							reshape based on your combat actions.
						</p>
					</article>

					<article class="feature-card">
						<div class="feature-icon"><Icon name="cube" size={26} /></div>
						<h3>Dynamic Weapons</h3>
						<p>
							Grab anything in the environment—vehicles, debris, signs—and use them as weapons 
							in dynamic, creative ways.
						</p>
					</article>

					<article class="feature-card">
						<div class="feature-icon"><Icon name="shield" size={26} /></div>
						<h3>Superhero Combat</h3>
						<p>
							Face off against another superpowered combatant. Each fight is unique with emergent 
							gameplay that rewards mastery and creativity.
						</p>
					</article>
				</div>
			</section>

			<section class="section reveal">
				<div class="section-heading">
					<p class="eyebrow">Status</p>
					<h2>Coming soon</h2>
				</div>

				<div class="specs-grid">
					<div class="spec-item">
						<span class="spec-label">Development</span>
						<span class="spec-value">Prototype phase</span>
					</div>
					<div class="spec-item">
						<span class="spec-label">Platform</span>
						<span class="spec-value">PC (Steam)</span>
					</div>
					<div class="spec-item">
						<span class="spec-label">Genre</span>
						<span class="spec-value">Fighting / Physics</span>
					</div>
					<div class="spec-item">
						<span class="spec-label">Release</span>
						<span class="spec-value">TBD</span>
					</div>
				</div>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>

<style>
	.game-hero {
		padding: 36px 0 48px;
	}

	/* Supporting line under the h1 — same treatment as the home page hero. */
	.hero-sub {
		margin: 14px 0 0;
		font-size: clamp(1.05rem, 1.6vw, 1.35rem);
		font-weight: 800;
		letter-spacing: -0.01em;
		color: var(--accent);
	}

	.features-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
	}

	.feature-card {
		padding: 26px 22px;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: rgba(10, 18, 26, 0.75);
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	.feature-card:hover {
		background: rgba(10, 18, 26, 0.95);
		border-color: rgba(114, 212, 255, 0.3);
		transform: translateY(-2px);
	}

	/* Was an emoji in a gradient disc; now a bordered badge holding an SVG icon. */
	.feature-icon {
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		margin-bottom: 18px;
		border: 1px solid rgba(114, 212, 255, 0.22);
		border-radius: 50%;
		color: var(--secondary);
		background: linear-gradient(135deg, rgba(114, 212, 255, 0.2), rgba(253, 185, 19, 0.16));
	}

	.feature-card h3 {
		margin: 0 0 10px;
		font-size: 1.2rem;
	}

	.feature-card p {
		margin: 0;
		color: var(--muted);
		line-height: 1.55;
	}

	.specs-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 16px;
	}

	.spec-item {
		display: flex;
		flex-direction: column;
		padding: 18px 16px;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: rgba(9, 17, 24, 0.5);
		backdrop-filter: blur(10px);
	}

	.spec-label {
		margin-bottom: 6px;
		font-size: 0.75rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.spec-value {
		font-size: 1rem;
		font-weight: 700;
		color: var(--text);
	}

	@media (max-width: 900px) {
		.features-grid {
			grid-template-columns: 1fr;
		}

		.specs-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 620px) {
		.specs-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
